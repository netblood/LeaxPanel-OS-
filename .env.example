# ============================================================================
#  LeaxPanel(os) Environment Configuration
# ============================================================================
#  Copy this file to `.env` and fill in the values, or simply run the
#  installer - it generates a complete `.env` with secure random secrets:
#
#      install.bat      (Windows)
#      ./install.sh     (Linux / macOS)
#
#  NEVER commit a populated `.env` to version control.
# ============================================================================

# ------------------------------------------------------------------ Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ----------------------------------------------------------------- Database
# SQLite file location (relative paths resolve from the project root).
DB_PATH=./data/leaxos.db

# ------------------------------------------------------------------ Session
# 64+ random characters. Generated automatically by the installer.
SESSION_SECRET=
SESSION_MAX_AGE=86400000

# ---------------------------------------------------------------------- JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------- Encryption
# AES-256-GCM key used for provider API keys and bot tokens.
# A 64-character hex string is used verbatim; anything else is hashed.
ENCRYPTION_KEY=

# ------------------------------------------------------- Administrator seed
# Used the first time the seeds run.
ADMIN_EMAIL=owner@leaxos.local
ADMIN_PASSWORD=
ADMIN_NAME=Owner
ADMIN_ROLE=owner

# -------------------------------------------------------------- Branding
PANEL_NAME=LeaxPanel
PANEL_TAGLINE=Host Anything. Manage Everything. Deploy Anywhere.
PANEL_LOGO=
PRIMARY_COLOR=#7c5cff
ACCENT_COLOR=#22d3ee
FOOTER_TEXT=Hosted & powered by LeaxPanel(os)

# --------------------------------------------------------------- Behaviour
# Allow visitors to create their own account (off by default).
REGISTRATION_ENABLED=false

# Invoices and payments are disabled by default. When off, only the
# service request system is used.
BILLING_ENABLED=false
BILLING_PROVIDER=manual

# Show the maintenance message to non-admin users.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=LeaxPanel is under maintenance. Please check back shortly.

SUPPORT_EMAIL=support@leaxos.local
SUPPORT_URL=

# ------------------------------------------------------------------- Backup
BACKUP_ENABLED=true
BACKUP_CRON=0 3 * * *
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------- Monitoring
MONITORING_INTERVAL=30000

# ----------------------------------------------------------------- Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ------------------------------------------------- Discord webhook (logs)
# Mirror audit events, authentication and errors to a Discord channel.
DISCORD_WEBHOOK_URL=

# ------------------------------------------------------ AI provider keys
# Optional shortcuts. Users can also configure their own providers per
# account from the "AI Providers" page.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# ------------------------------------------------------------------- Email
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leaxos.local

# ----------------------------------------------------------------- Billing
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# -------------------------------------------------------------- Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
