# LeaxPanel(os) Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database
DATABASE_URL=postgresql://leaxos:leaxos_password@localhost:5432/leaxos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=leaxos
DB_USER=leaxos
DB_PASSWORD=leaxos_password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=leaxos_redis_password

# Session
SESSION_SECRET=leaxos_session_secret_change_in_production
SESSION_MAX_AGE=86400000

# JWT
JWT_SECRET=leaxos_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=leaxos_encryption_key_32_chars

# AI Providers (users can configure their own)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GROK_API_KEY=
OPENROUTER_API_KEY=

# Email (Stalwart / SMTP)
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leaxos.local

# Billing (disabled by default)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Cloudflare
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=

# Docker
DOCKER_HOST=/var/run/docker.sock

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
FAIL2BAN_ENABLED=false
CROWDSEC_ENABLED=false

# Monitoring
MONITORING_INTERVAL=30000

# Backup
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30