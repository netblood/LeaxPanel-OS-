@echo off
:: ============================================================================
:: LeaxPanel(os) - Windows Installer (Batch)
:: ============================================================================
:: One-command install from GitHub:
::   iwr -useb https://raw.githubusercontent.com/netblood/LeaxPanel-OS-/main/install.bat | iex
::
:: This script:
::   1. Checks Node.js & npm
::   2. Generates secure random passwords for all services (via PowerShell)
::   3. Creates .env with generated credentials
::   4. Creates docker-compose.override.yml to wire passwords into Docker
::   5. Starts PostgreSQL, Redis, Minio via Docker
::   6. Runs database migrations and seeds
::   7. Displays all service credentials
:: ============================================================================

setlocal enabledelayedexpansion

:: Change to the directory where this script lives (project root)
cd /d "%~dp0"

echo.
echo ============================================================================
echo   LeaxPanel(os) - Complete Cloud Operating System
echo   Windows Installer - Auto Setup
echo ============================================================================
echo.
:: ---- Generate all credentials via PowerShell ----
echo [*] Generating secure service credentials...
for /f "tokens=*" %%p in ('powershell -NoProfile -Command "function Gen($l){$c='abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';-join(1..$l|ForEach-Object{$c[(Get-Random -Maximum $c.Length)]})};Write-Output (Gen 16 + \"`n\" + Gen 16 + \"`n\" + Gen 16 + \"`n\" + Gen 32 + \"`n\" + Gen 32 + \"`n\" + Gen 32)"') do (
    set "CRED_LINE=%%p"
    if not defined DB_PASSWORD (set "DB_PASSWORD=!CRED_LINE!") else if not defined REDIS_PASSWORD (set "REDIS_PASSWORD=!CRED_LINE!") else if not defined MINIO_PASSWORD (set "MINIO_PASSWORD=!CRED_LINE!") else if not defined SESSION_SECRET (set "SESSION_SECRET=!CRED_LINE!") else if not defined JWT_SECRET (set "JWT_SECRET=!CRED_LINE!") else if not defined ENCRYPTION_KEY (set "ENCRYPTION_KEY=!CRED_LINE!")
)
echo    Credentials generated.

:: Check Node.js
echo [1/9] Checking Node.js...
where node >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: Node.js is not installed or not in PATH.
    echo Please install Node.js 22+ from https://nodejs.org/
    pause
    exit /b 1
)
node --version
echo Node.js found.

:: Check npm
echo [2/9] Checking npm...
npm --version >nul 2>&1
if %errorlevel% neq 0 (
    echo ERROR: npm is not available.
    pause
    exit /b 1
)
npm --version
echo npm found.

:: Check Docker (optional - for PostgreSQL, Redis, Minio)
echo [3/9] Checking Docker...
where docker >nul 2>&1
if %errorlevel% neq 0 (
    echo WARNING: Docker not found. PostgreSQL/Redis/Minio will not be auto-started.
    echo Please install Docker Desktop from https://www.docker.com/products/docker-desktop/
    echo Or install PostgreSQL and Redis manually and configure .env accordingly.
    set DOCKER_AVAILABLE=0
) else (
    echo Docker found.
    set DOCKER_AVAILABLE=1
)

:: Create .env with generated credentials
echo [4/9] Setting up environment configuration (.env)...
(
    echo # LeaxPanel(os) Environment Configuration
    echo # Auto-generated by installer - DO NOT COMMIT TO VERSION CONTROL
    echo NODE_ENV=development
    echo PORT=3000
    echo HOST=0.0.0.0
    echo.
    echo # Database
    echo DATABASE_URL=postgresql://leaxos:%DB_PASSWORD%@localhost:5432/leaxos
    echo DB_HOST=localhost
    echo DB_PORT=5432
    echo DB_NAME=leaxos
    echo DB_USER=leaxos
    echo DB_PASSWORD=%DB_PASSWORD%
    echo.
    echo # Redis
    echo REDIS_HOST=localhost
    echo REDIS_PORT=6379
    echo REDIS_PASSWORD=%REDIS_PASSWORD%
    echo.
    echo # Minio (Object Storage)
    echo MINIO_HOST=localhost
    echo MINIO_PORT=9000
    echo MINIO_CONSOLE_PORT=9001
    echo MINIO_ROOT_USER=leaxos
    echo MINIO_ROOT_PASSWORD=%MINIO_PASSWORD%
    echo.
    echo # Session
    echo SESSION_SECRET=%SESSION_SECRET%
    echo SESSION_MAX_AGE=86400000
    echo.
    echo # JWT
    echo JWT_SECRET=%JWT_SECRET%
    echo JWT_EXPIRES_IN=7d
    echo.
    echo # Encryption (AES-256-GCM, must be 32 chars)
    echo ENCRYPTION_KEY=%ENCRYPTION_KEY%
    echo.
    echo # AI Providers (users can configure their own)
    echo OPENAI_API_KEY=
    echo ANTHROPIC_API_KEY=
    echo GOOGLE_API_KEY=
    echo DEEPSEEK_API_KEY=
    echo GROK_API_KEY=
    echo OPENROUTER_API_KEY=
    echo.
    echo # Email (Stalwart / SMTP)
    echo SMTP_HOST=localhost
    echo SMTP_PORT=25
    echo SMTP_USER=
    echo SMTP_PASSWORD=
    echo SMTP_FROM=noreply@leaxos.local
    echo.
    echo # Billing (disabled by default)
    echo STRIPE_SECRET_KEY=
    echo STRIPE_PUBLISHABLE_KEY=
    echo STRIPE_WEBHOOK_SECRET=
    echo PAYPAL_CLIENT_ID=
    echo PAYPAL_CLIENT_SECRET=
    echo PAYPAL_MODE=sandbox
    echo.
    echo # Cloudflare
    echo CLOUDFLARE_API_TOKEN=
    echo CLOUDFLARE_ACCOUNT_ID=
    echo CLOUDFLARE_ZONE_ID=
    echo.
    echo # Docker
    echo DOCKER_HOST=/var/run/docker.sock
    echo.
    echo # Security
    echo RATE_LIMIT_WINDOW_MS=900000
    echo RATE_LIMIT_MAX=100
    echo FAIL2BAN_ENABLED=false
    echo CROWDSEC_ENABLED=false
    echo.
    echo # Monitoring
    echo MONITORING_INTERVAL=30000
    echo.
    echo # Backup
    echo BACKUP_ENABLED=true
    echo BACKUP_RETENTION_DAYS=30
    echo ENCRYPTION_KEY=%ENCRYPTION_KEY%
) > .env
echo    .env created with auto-generated credentials.

:: Create docker-compose.override.yml to wire credentials into Docker services
echo [5/9] Creating Docker Compose override with credentials...
(
    echo version: '3.8'
    echo services:
    echo   postgres:
    echo     environment:
    echo       POSTGRES_PASSWORD: %DB_PASSWORD%
    echo   redis:
    echo     command: redis-server --requirepass %REDIS_PASSWORD%
    echo     healthcheck:
    echo       test: ["CMD", "redis-cli", "-a", "%REDIS_PASSWORD%", "ping"]
    echo   minio:
    echo     environment:
    echo       MINIO_ROOT_PASSWORD: %MINIO_PASSWORD%
    echo   leaxos:
    echo     environment:
    echo       - DB_PASSWORD=%DB_PASSWORD%
    echo       - REDIS_PASSWORD=%REDIS_PASSWORD%
) > docker-compose.override.yml
echo    docker-compose.override.yml created.

:: Install npm dependencies
echo [6/9] Installing npm dependencies...
npm install
if %errorlevel% neq 0 (
    echo ERROR: npm install failed.
    pause
    exit /b 1
)
echo Dependencies installed successfully.

:: Start Docker services if available
if %DOCKER_AVAILABLE% equ 1 (
    echo [7/9] Starting Docker services (PostgreSQL, Redis, Minio)...
    docker compose up -d postgres redis minio
    if %errorlevel% neq 0 (
        echo WARNING: docker compose up failed. Trying docker-compose...
        docker-compose up -d postgres redis minio
        if %errorlevel% neq 0 (
            echo WARNING: Could not start Docker services. You may need to start them manually.
        )
    )

    :: Wait for PostgreSQL to be ready
    echo [8/9] Waiting for PostgreSQL to be ready...
    set /a ATTEMPTS=0
    :pg_wait
    if %ATTEMPTS% geq 60 (
        echo WARNING: PostgreSQL did not become ready in time. Migrations may fail.
        goto skip_migrate
    )
    docker compose exec -T postgres pg_isready -U leaxos -d leaxos >nul 2>&1
    if %errorlevel% neq 0 (
        set /a ATTEMPTS+=1
        timeout /t 2 >nul
        goto pg_wait
    )
    echo PostgreSQL is ready.

    :: Run database migrations
    echo [9/9] Running database migrations...
    node migrations/run.js
    if %errorlevel% neq 0 (
        echo WARNING: Migrations failed. You can run them manually later with: node migrations/run.js
    ) else (
        echo Migrations completed successfully.

        :: Run database seeds
        echo Running database seeds...
        node seeds/run.js
        if %errorlevel% neq 0 (
            echo WARNING: Seeds failed. You can run them manually later with: node seeds/run.js
        ) else (
            echo Seeds completed successfully.
        )
    )
    :skip_migrate
) else (
    echo [7/9] Skipping Docker services (Docker not available).
    echo [8/9] Skipping migrations (PostgreSQL not available).
    echo [9/9] Skipping seeds (PostgreSQL not available).
)

:: Optional: Fix vulnerabilities
echo Running npm audit fix (optional)...
npm audit fix --force >nul 2>&1

echo.
echo ============================================================================
echo   Installation complete!
echo ============================================================================
echo.
echo To start the server, run: run.bat
echo Or manually: node server.js
echo.
echo Default admin credentials (after seeding):
echo   Email:    owner@leaxos.local
echo   Password: (set during seed or first login)
echo.
echo ============================================================================
echo   SERVICE CREDENTIALS (auto-generated - save these!)
echo ============================================================================
echo   Database (PostgreSQL):
echo     Host: localhost:5432
echo     User: leaxos
echo     Password: %DB_PASSWORD%
echo     Database: leaxos
echo.
echo   Redis:
echo     Host: localhost:6379
echo     Password: %REDIS_PASSWORD%
echo.
echo   Minio (Object Storage):
echo     Host: localhost:9000
echo     Console: localhost:9001
echo     User: leaxos
echo     Password: %MINIO_PASSWORD%
echo.
echo   Session Secret: %SESSION_SECRET%
echo   JWT Secret: %JWT_SECRET%
echo   Encryption Key: %ENCRYPTION_KEY%
echo.
echo   Default Admin: owner@leaxos.local
echo.
echo   Save these credentials! They will not be shown again.
echo.
pause



