[Unit]
Description=LeaxAgent node runtime
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/opt/leaxagent
EnvironmentFile=/etc/leaxagent/agent.env
ExecStart=/usr/bin/node /opt/leaxagent/agent/index.mjs
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
