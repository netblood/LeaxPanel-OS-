<div class="page-header">
  <div>
    <h1 class="page-title">My profile</h1>
    <p class="page-subtitle">Manage your account, security and AI preferences</p>
  </div>
  <div class="page-actions">
    <a href="/apiKeys" class="btn btn-secondary">API keys</a>
  </div>
</div>

<div class="grid-2" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:var(--sp-4);margin-bottom:var(--sp-4);">
  <form action="/profile" method="POST" class="card" data-loading>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="card-header">
      <div>
        <h3>Account details</h3>
        <p>Your public information inside the panel</p>
      </div>
    </div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label" for="name">Full name<span class="req">*</span></label>
        <input class="form-control" type="text" id="name" name="name" value="<%= profile.name || '' %>" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="email">Email address<span class="req">*</span></label>
        <input class="form-control" type="email" id="email" name="email" value="<%= profile.email || '' %>" required>
      </div>
      <div class="form-group">
        <label class="form-label">Role</label>
        <input class="form-control" type="text" value="<%= profile.role || '' %>" readonly>
      </div>
    </div>
    <div class="card-footer form-actions">
      <button type="submit" class="btn btn-primary">Save profile</button>
    </div>
  </form>

  <div class="card">
    <div class="card-header">
      <div>
        <h3>Security</h3>
        <p>Password and two-factor authentication</p>
      </div>
    </div>
    <div class="card-body">
      <form action="/profile/password" method="POST" data-loading>
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="form-group">
          <label class="form-label" for="current_password">Current password</label>
          <input class="form-control" type="password" id="current_password" name="current_password" required autocomplete="current-password">
        </div>
        <div class="form-group">
          <label class="form-label" for="new_password">New password</label>
          <input class="form-control" type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password">
          <span class="form-hint">At least 8 characters.</span>
        </div>
        <button type="submit" class="btn btn-secondary">Change password</button>
      </form>

      <hr style="border:none;border-top:1px solid var(--border);margin:var(--sp-5) 0;">

      <div class="activity-item">
        <span class="activity-icon">◈</span>
        <div class="activity-body">
          <div class="activity-title">Two-factor authentication</div>
          <div class="activity-meta">
            <% if (profile.two_factor_enabled) { %>
              Enabled - your account is protected with a TOTP code.
            <% } else { %>
              Not enabled. Add an extra layer of protection to your account.
            <% } %>
          </div>
        </div>
        <% if (profile.two_factor_enabled) { %>
          <form action="/profile/2fa/disable" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-danger btn-sm" data-confirm="Disable two-factor authentication?">Disable</button>
          </form>
        <% } else { %>
          <a href="/2fa/setup" class="btn btn-primary btn-sm">Enable</a>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <h3>AI providers</h3>
      <p>Your personal AI configuration</p>
    </div>
    <a href="/ai-settings" class="btn btn-secondary btn-sm">Manage</a>
  </div>
  <div class="card-body">
    <% if ((aiSettings || []).length) { %>
      <div class="activity-list">
        <% aiSettings.forEach(function(s) { %>
          <div class="activity-item">
            <span class="activity-icon">◈</span>
            <div class="activity-body">
              <div class="activity-title"><%= s.name %></div>
              <div class="activity-meta"><%= s.provider %> · <%= s.model || 'no model set' %></div>
            </div>
            <% if (s.is_default) { %><span class="badge badge-primary">Default</span><% } %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="empty-state" style="padding:var(--sp-8) var(--sp-4);">
        <div class="empty-icon">◈</div>
        <h3>No AI providers configured</h3>
        <p>Connect OpenAI, Claude, Gemini, OpenRouter or any OpenAI-compatible API.</p>
        <a href="/ai-settings" class="btn btn-primary btn-sm">Add provider</a>
      </div>
    <% } %>
  </div>
</div>
