<%- include('../partials/head'); %>
<title>Dashboard - LEAXOS</title>
<body>
  <%- include('../partials/navbar'); %>
  <main class="container">
    <%- include('../partials/flash'); %>
    <h1>Dashboard</h1>
    <div class="stats-grid">
      <div class="stat-card">
        <h3>Users</h3>
        <p><%= stats.users || 0 %></p>
      </div>
      <div class="stat-card">
        <h3>Services</h3>
        <p><%= stats.services || 0 %></p>
      </div>
      <div class="stat-card">
        <h3>AI Agents</h3>
        <p><%= stats.aiAgents || 0 %></p>
      </div>
      <div class="stat-card">
        <h3>Backups</h3>
        <p><%= stats.backups || 0 %></p>
      </div>
    </div>
    <h2>Recent Activity</h2>
    <ul class="activity-list">
      <% recent.forEach(function(item) { %>
        <li><%= item %></li>
      <% }); %>
    </ul>
  </main>
  <script src="/js/main.js"></script>
</body>
