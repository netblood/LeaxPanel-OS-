<%
  const s = stats || {};
  const cpu = s.cpu || { usage: 0, cores: 0, load: 0 };
  const mem = s.memory || { usage: 0, usedLabel: '—', totalLabel: '—' };
  const disk = s.disk || { usage: 0, usedLabel: '—', totalLabel: '—' };
  const net = s.network || [];
  const tone = (v) => (v >= 90 ? 'danger' : v >= 75 ? 'warning' : '');
  const statusTone = (status) => {
    const map = {
      running: 'success', healthy: 'success', active: 'success', online: 'success',
      warning: 'warning', degraded: 'warning', pending: 'warning',
      offline: 'danger', error: 'danger', stopped: 'muted', inactive: 'muted'
    };
    return map[String(status || '').toLowerCase()] || 'info';
  };
  const quickActions = [
    { label: 'Create Website', href: '/website/create', icon: '🌐', desc: 'Deploy a new website' },
    { label: 'Create WordPress', href: '/apps/create?type=wordpress', icon: '📝', desc: 'Deploy WordPress site' },
    { label: 'Create WooCommerce', href: '/apps/create?type=woocommerce', icon: '🛒', desc: 'Deploy WooCommerce store' },
    { label: 'Create NodeJS App', href: '/apps/create?type=nodejs', icon: '📦', desc: 'Deploy Node.js application' },
    { label: 'Create PHP App', href: '/apps/create?type=php', icon: '🐘', desc: 'Deploy PHP application' },
    { label: 'Create Telegram Bot', href: '/telegram/create', icon: '✈️', desc: 'Deploy Telegram bot' },
    { label: 'Create Discord Bot', href: '/discord/create', icon: '🎮', desc: 'Deploy Discord bot' },
    { label: 'Create WhatsApp Instance', href: '/whatsapp/create', icon: '📱', desc: 'Connect WhatsApp' },
    { label: 'Create AI Agent', href: '/ai/create', icon: '🤖', desc: 'Deploy AI agent' },
    { label: 'Create n8n Workflow', href: '/n8n/create', icon: '🔄', desc: 'Create automation workflow' },
    { label: 'Create Database', href: '/databases/create', icon: '🗄️', desc: 'Create new database' },
    { label: 'Create Domain', href: '/domains/create', icon: '🌍', desc: 'Add new domain' },
    { label: 'Create Email', href: '/email/create', icon: '📧', desc: 'Create email account' },
    { label: 'Create Backup', href: '/backups/create', icon: '💾', desc: 'Create new backup' }
  ];
  const serviceCategories = [
    { key: 'webHosting', label: 'Web Hosting', icon: '🌐', href: '/website', count: s.websites || 0, status: 'running' },
    { key: 'nodejsHosting', label: 'NodeJS Hosting', icon: '📦', href: '/apps?type=nodejs', count: (s.apps || 0), status: 'running' },
    { key: 'phpHosting', label: 'PHP Hosting', icon: '🐘', href: '/apps?type=php', count: 0, status: 'running' },
    { key: 'wordpressHosting', label: 'WordPress Hosting', icon: '📝', href: '/apps?type=wordpress', count: 0, status: 'running' },
    { key: 'woocommerceHosting', label: 'WooCommerce Hosting', icon: '🛒', href: '/apps?type=woocommerce', count: 0, status: 'running' },
    { key: 'telegramHosting', label: 'Telegram Hosting', icon: '✈️', href: '/telegram', count: (s.telegramBots || 0), status: 'running' },
    { key: 'discordHosting', label: 'Discord Hosting', icon: '🎮', href: '/discord', count: (s.discordBots || 0), status: 'running' },
    { key: 'whatsappHosting', label: 'WhatsApp Hosting', icon: '📱', href: '/whatsapp', count: (s.whatsappInstances || 0), status: 'running' },
    { key: 'n8nHosting', label: 'N8N Hosting', icon: '🔄', href: '/n8n', count: (s.workflows || 0), status: 'running' },
    { key: 'aiHosting', label: 'AI Hosting', icon: '🤖', href: '/ai-hosting', count: (s.aiHosting || 0), status: 'running' },
    { key: 'databaseHosting', label: 'Database Hosting', icon: '🗄️', href: '/databases', count: (s.databases || 0), status: 'running' },
    { key: 'emailHosting', label: 'Email Hosting', icon: '📧', href: '/email', count: (s.emailAccounts || 0), status: 'running' },
    { key: 'storageHosting', label: 'Storage Hosting', icon: '💾', href: '/storage', count: (s.storageBuckets || 0), status: 'running' }
  ];
%>
<div class="page-header">
  <div>
    <h1 class="page-title">Dashboard</h1>
    <p class="page-subtitle">Live overview of your cloud platform</p>
  </div>
  <div class="page-actions">
    <a href="/doctor" class="btn btn-secondary">Health check</a>
    <a href="/setup" class="btn btn-secondary">Setup wizard</a>
    <a href="/apps/create" class="btn btn-primary">Deploy app</a>
  </div>
</div>

<!-- System Overview (8 metrics) -->
<section class="dashboard-section" aria-labelledby="system-overview-heading">
  <header class="section-header">
    <h2 id="system-overview-heading" class="section-title">System Overview</h2>
    <p class="section-description">Key metrics across your platform</p>
  </header>
  <div class="system-overview-grid">
    <a href="/website" class="stat-card-enhanced" data-metric="websites">
      <div class="stat-card-icon">🌐</div>
      <div class="stat-card-content">
        <div class="stat-card-label">Total Websites</div>
        <div class="stat-card-value"><%= s.websites || 0 %></div>
        <div class="stat-card-trend"><%= s.domains || 0 %> domains</div>
      </div>
    </a>
    <a href="/apps" class="stat-card-enhanced" data-metric="apps">
      <div class="stat-card-icon">📦</div>
      <div class="stat-card-content">
        <div class="stat-card-label">Total Apps</div>
        <div class="stat-card-value"><%= s.apps || 0 %></div>
        <div class="stat-card-trend"><%= s.activeServices || 0 %> active</div>
      </div>
    </a>
    <a href="/bots" class="stat-card-enhanced" data-metric="bots">
      <div class="stat-card-icon">🎮</div>
      <div class="stat-card-content">
        <div class="stat-card-label">Total Bots</div>
        <div class="stat-card-value"><%= s.bots || 0 %></div>
        <div class="stat-card-trend">all platforms</div>
      </div>
    </a>
    <a href="/n8n" class="stat-card-enhanced" data-metric="workflows">
      <div class="stat-card-icon">🔄</div>
      <div class="stat-card-content">
        <div class="stat-card-label">Workflows</div>
        <div class="stat-card-value"><%= s.workflows || 0 %></div>
        <div class="stat-card-trend">automations</div>
      </div>
    </a>
    <a href="/ai" class="stat-card-enhanced" data-metric="aiAgents">
      <div class="stat-card-icon">🤖</div>
      <div class="stat-card-content">
        <div class="stat-card-label">AI Agents</div>
        <div class="stat-card-value"><%= s.aiAgents || 0 %></div>
        <div class="stat-card-trend">agents</div>
      </div>
    </a>
    <a href="/domains" class="stat-card-enhanced" data-metric="domains">
      <div class="stat-card-icon">🌍</div>
      <div class="stat-card-content">
        <div class="stat-card-label">Total Domains</div>
        <div class="stat-card-value"><%= s.domains || 0 %></div>
        <div class="stat-card-trend">registered</div>
      </div>
    </a>
    <a href="/users" class="stat-card-enhanced" data-metric="users">
      <div class="stat-card-icon">👥</div>
      <div class="stat-card-content">
        <div class="stat-card-label">Total Users</div>
        <div class="stat-card-value"><%= s.users || 0 %></div>
        <div class="stat-card-trend">accounts</div>
      </div>
    </a>
    <a href="/databases" class="stat-card-enhanced" data-metric="databases">
      <div class="stat-card-icon">🗄️</div>
      <div class="stat-card-content">
        <div class="stat-card-label">Total Databases</div>
        <div class="stat-card-value"><%= s.databases || 0 %></div>
        <div class="stat-card-trend">instances</div>
      </div>
    </a>
  </div>
</section>

<!-- Infrastructure Status (6 metrics) -->
<section class="dashboard-section" aria-labelledby="infra-status-heading">
  <header class="section-header">
    <h2 id="infra-status-heading" class="section-title">Infrastructure Status</h2>
    <p class="section-description">Real-time system health and resources</p>
  </header>
  <div class="infrastructure-status-grid">
    <div class="infra-card">
      <div class="infra-card-header">
        <span class="infra-icon">◴</span>
        <span class="infra-label">CPU</span>
        <span class="infra-badge <%= tone(cpu.usage) %>"><%= cpu.usage %>%</span>
      </div>
      <div class="infra-progress">
        <div class="progress-bar">
          <div class="progress-fill <%= tone(cpu.usage) %>" style="width: <%= Math.min(100, cpu.usage) %>%"></div>
        </div>
        <div class="infra-meta"><%= cpu.cores %> cores · load <%= Number(cpu.load || 0).toFixed(2) %></div>
      </div>
    </div>
    <div class="infra-card">
      <div class="infra-card-header">
        <span class="infra-icon">◑</span>
        <span class="infra-label">RAM</span>
        <span class="infra-badge <%= tone(mem.usage) %>"><%= mem.usage %>%</span>
      </div>
      <div class="infra-progress">
        <div class="progress-bar">
          <div class="progress-fill <%= tone(mem.usage) %>" style="width: <%= Math.min(100, mem.usage) %>%"></div>
        </div>
        <div class="infra-meta"><%= mem.usedLabel %> of <%= mem.totalLabel %></div>
      </div>
    </div>
    <div class="infra-card">
      <div class="infra-card-header">
        <span class="infra-icon">◱</span>
        <span class="infra-label">Disk</span>
        <span class="infra-badge <%= tone(disk.usage) %>"><%= disk.usage %>%</span>
      </div>
      <div class="infra-progress">
        <div class="progress-bar">
          <div class="progress-fill <%= tone(disk.usage) %>" style="width: <%= Math.min(100, disk.usage) %>%"></div>
        </div>
        <div class="infra-meta"><%= disk.usedLabel %> of <%= disk.totalLabel %></div>
      </div>
    </div>
    <div class="infra-card">
      <div class="infra-card-header">
        <span class="infra-icon">⇅</span>
        <span class="infra-label">Bandwidth</span>
        <span class="infra-badge info"><%= net.length %> ifaces</span>
      </div>
      <div class="infra-progress">
        <div class="progress-bar">
          <div class="progress-fill info" style="width: 45%"></div>
        </div>
        <div class="infra-meta">
          <% net.slice(0, 2).forEach(function(n) { %><span class="badge badge-muted badge-plain"><%= n.address %></span> <% }); %>
        </div>
      </div>
    </div>
    <div class="infra-card">
      <div class="infra-card-header">
        <span class="infra-icon">💾</span>
        <span class="infra-label">Backups</span>
        <span class="infra-badge <%= (s.backups || 0) > 0 ? 'success' : 'warning' %>"><%= s.backups || 0 %></span>
      </div>
      <div class="infra-progress">
        <div class="progress-bar">
          <div class="progress-fill <%= (s.backups || 0) > 0 ? 'success' : 'warning' %>" style="width: <%= Math.min(100, (s.backups || 0) * 10) %>%"></div>
        </div>
        <div class="infra-meta"><%= s.backups || 0 %> backups stored</div>
      </div>
    </div>
    <div class="infra-card security-score-card">
      <div class="infra-card-header">
        <span class="infra-icon">🛡️</span>
        <span class="infra-label">Security Score</span>
        <span class="infra-badge <%= securityScore >= 80 ? 'success' : securityScore >= 55 ? 'warning' : 'danger' %>"><%= securityScore %>%</span>
      </div>
      <div class="infra-progress">
        <div class="progress-ring" style="--progress: <%= securityScore %>%;">
          <span><%= securityScore %></span>
        </div>
        <div class="infra-meta">
          <%= securityScore >= 80 ? 'Excellent' : securityScore >= 55 ? 'Good' : 'Action needed' %>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Quick Create Section (14 actions) -->
<section class="dashboard-section" aria-labelledby="quick-create-heading">
  <header class="section-header">
    <h2 id="quick-create-heading" class="section-title">Quick Create</h2>
    <p class="section-description">Deploy new resources in one click</p>
  </header>
  <div class="quick-create-grid" id="quickCreateGrid">
    <% quickActions.forEach(function(action) { %>
      <a href="<%= action.href %>" class="quick-create-card" title="<%= action.desc %>">
        <div class="quick-create-icon"><%= action.icon %></div>
        <div class="quick-create-label"><%= action.label %></div>
      </a>
    <% }); %>
  </div>
</section>

<!-- Service Cards Grid (13 categories) -->
<section class="dashboard-section" aria-labelledby="service-cards-heading">
  <header class="section-header">
    <h2 id="service-cards-heading" class="section-title">Service Categories</h2>
    <p class="section-description">Manage all your services from one place</p>
  </header>
  <div class="service-cards-grid">
    <% serviceCategories.forEach(function(svc) { %>
      <article class="service-card" data-service="<%= svc.key %>">
        <div class="service-card-header">
          <div class="service-icon"><%= svc.icon %></div>
          <div class="service-title">
            <h3><%= svc.label %></h3>
            <span class="service-count"><%= svc.count %> items</span>
          </div>
          <span class="status-indicator <%= statusTone(svc.status) %>" data-status="<%= svc.status %>">
            <span class="status-dot"></span>
            <span class="status-text"><%= svc.status %></span>
          </span>
        </div>
        <div class="service-card-actions">
          <a href="<%= svc.href %>/create" class="service-action-btn primary" title="Install new <%= svc.label.toLowerCase() %>">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            <span>Install</span>
          </a>
          <a href="<%= svc.href %>" class="service-action-btn secondary" title="Manage <%= svc.label.toLowerCase() %>">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
            <span>Manage</span>
          </a>
          <a href="<%= svc.href %>" class="service-action-btn tertiary" title="View <%= svc.label.toLowerCase() %> stats">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="16"></line></svg>
            <span>Stats</span>
          </a>
          <a href="/docs/<%= svc.key %>" class="service-action-btn tertiary" target="_blank" rel="noopener" title="<%= svc.label %> documentation">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
            <span>Docs</span>
          </a>
        </div>
      </article>
    <% }); %>
  </div>
</section>

<!-- Activity & Logs Section -->
<div class="grid-2" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:var(--sp-4);margin-bottom:var(--sp-4);">
  <!-- Latest logs -->
  <section class="card" aria-labelledby="latest-logs-heading">
    <header class="card-header">
      <div>
        <h3 id="latest-logs-heading">Latest Logs</h3>
        <p>Most recent audit events</p>
      </div>
      <a href="/security/audit" class="btn btn-secondary btn-sm">View all</a>
    </header>
    <div class="card-body">
      <% if ((recentLogs || []).length) { %>
        <div class="activity-list">
          <% recentLogs.forEach(function(log) { %>
            <div class="activity-item">
              <span class="activity-icon">›</span>
              <div class="activity-body">
                <div class="activity-title"><%= log.action || 'action' %> <%= log.resource || '' %></div>
                <div class="activity-meta"><%= log.ip_address || 'local' %> · <%= log.status_code || '' %></div>
              </div>
              <span class="badge badge-<%= Number(log.status_code) >= 400 ? 'danger' : 'muted' %>"><%= log.status_code || '—' %></span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state" style="padding:var(--sp-8) var(--sp-4);">
          <div class="empty-icon">›</div>
          <h3>No activity yet</h3>
          <p>Actions you take in the panel will show up here.</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Latest backups -->
  <section class="card" aria-labelledby="latest-backups-heading">
    <header class="card-header">
      <div>
        <h3 id="latest-backups-heading">Latest Backups</h3>
        <p>Restore points available to you</p>
      </div>
      <a href="/backups" class="btn btn-secondary btn-sm">Manage</a>
    </header>
    <div class="card-body">
      <% if ((recentBackups || []).length) { %>
        <div class="activity-list">
          <% recentBackups.forEach(function(b) { %>
            <div class="activity-item">
              <span class="activity-icon">◫</span>
              <div class="activity-body">
                <div class="activity-title"><%= b.name %></div>
                <div class="activity-meta"><%= b.type %> · <%= b.created_at %></div>
              </div>
              <span class="badge badge-<%= b.status === 'completed' ? 'success' : 'warning' %>"><%= b.status %></span>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state" style="padding:var(--sp-8) var(--sp-4);">
          <div class="empty-icon">◫</div>
          <h3>No backups yet</h3>
          <p>Create your first backup to protect your resources.</p>
          <a href="/backups/create" class="btn btn-primary btn-sm">Create backup</a>
        </div>
      <% } %>
    </div>
  </section>
</div>

<!-- Latest activity & Resource distribution -->
<div class="grid-2" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:var(--sp-4);margin-bottom:var(--sp-4);">
  <!-- Latest activity -->
  <section class="card" aria-labelledby="latest-activity-heading">
    <header class="card-header">
      <div>
        <h3 id="latest-activity-heading">Latest Activity</h3>
        <p>Everything happening on your panel</p>
      </div>
    </header>
    <div class="card-body">
      <% if ((activity || []).length) { %>
        <div class="activity-list">
          <% activity.forEach(function(a) { %>
            <div class="activity-item">
              <span class="activity-icon">●</span>
              <div class="activity-body">
                <div class="activity-title"><%= a.action || 'Activity' %></div>
                <div class="activity-meta"><%= a.resource || '' %> · <%= a.created_at %></div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state" style="padding:var(--sp-8) var(--sp-4);">
          <div class="empty-icon">●</div>
          <h3>Nothing to show</h3>
          <p>Your panel activity will be tracked here.</p>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Resource distribution -->
  <section class="card" aria-labelledby="resource-dist-heading">
    <header class="card-header">
      <div>
        <h3 id="resource-dist-heading">Resource Distribution</h3>
        <p>What is running on your platform</p>
      </div>
    </header>
    <div class="card-body">
      <% const distro = [
        { label: 'Websites', value: s.websites || 0 },
        { label: 'Applications', value: s.apps || 0 },
        { label: 'Databases', value: s.databases || 0 },
        { label: 'Bots', value: s.bots || 0 },
        { label: 'Workflows', value: s.workflows || 0 },
        { label: 'Domains', value: s.domains || 0 }
      ]; %>
      <% const maxVal = Math.max(1, ...distro.map(d => d.value)); %>
      <div class="chart">
        <% distro.forEach(function(d) { %>
          <div class="chart-col" title="<%= d.label %>: <%= d.value %>">
            <div class="chart-bar" style="height:<%= Math.max(4, Math.round((d.value / maxVal) * 100)) %>%"></div>
            <div class="chart-label"><%= d.value %></div>
            <div class="chart-label"><%= d.label %></div>
          </div>
        <% }); %>
      </div>
    </div>
  </section>
</div>