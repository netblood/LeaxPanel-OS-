<div class="page-header">
  <div>
    <h1 class="page-title">Terminal Center</h1>
    <p class="page-subtitle">Browser-based terminal with project-scoped access, permission controlled and audited</p>
  </div>
  <div class="page-actions">
    <button type="button" class="btn btn-primary" id="newTerminalBtn">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      New Terminal
    </button>
    <div class="dropdown" style="margin-left:8px;">
      <button class="btn btn-secondary dropdown-toggle" data-bs-toggle="dropdown">Sessions</button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><a class="dropdown-item" href="#" data-action="list">Active Sessions</a></li>
        <li><a class="dropdown-item" href="#" data-action="history">Session History</a></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item text-danger" href="#" data-action="kill-all">Kill All Sessions</a></li>
      </ul>
    </div>
  </div>
</div>

<div class="card" style="margin-bottom:var(--sp-4);">
  <div class="card-header">
    <div class="card-title-row">
      <h3>Terminal Instances</h3>
      <span class="badge badge-info" id="activeCount">0 active</span>
    </div>
  </div>
  <div class="card-body">
    <div id="terminalList" class="terminal-list">
      <div class="empty-state" id="emptyState">
        <div class="empty-icon">_</div>
        <h3>No active terminal sessions</h3>
        <p>Click "New Terminal" to start a new session in your project workspace</p>
      </div>
    </div>
  </div>
</div>

<div class="card" id="terminalContainer" style="display:none; height:600px;">
  <div class="card-header d-flex justify-content-between align-items-center">
    <div>
      <h3 class="mb-0" id="currentTerminalTitle">Terminal</h3>
      <small class="text-muted" id="currentTerminalPath">~/workspace</small>
    </div>
    <div class="btn-group btn-group-sm">
      <button type="button" class="btn btn-secondary" id="clearTerminalBtn" title="Clear terminal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
      </button>
      <button type="button" class="btn btn-secondary" id="restartTerminalBtn" title="Restart session">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path><path d="M21 21v-5h-5"></path></svg>
      </button>
      <button type="button" class="btn btn-secondary" id="resizeTerminalBtn" title="Fit to container">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3"></path></svg>
      </button>
      <button type="button" class="btn btn-danger" id="closeTerminalBtn" title="Close terminal">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>
  <div class="card-body p-0" style="height:calc(100% - 56px);">
    <div id="terminal" style="width:100%; height:100%;"></div>
  </div>
</div>

<!-- New Terminal Modal -->
<div class="modal fade" id="newTerminalModal" tabindex="-1" aria-labelledby="newTerminalModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="newTerminalModalLabel">New Terminal Session</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form id="newTerminalForm" data-loading>
        <div class="modal-body">
          <div class="form-group">
            <label class="form-label" for="terminalName">Session Name</label>
            <input type="text" class="form-control" id="terminalName" name="name" placeholder="My Terminal Session" required>
          </div>
          <div class="form-group">
            <label class="form-label" for="terminalPath">Working Directory</label>
            <input type="text" class="form-control" id="terminalPath" name="path" placeholder="/home/user/project" value="/home/<%= user?.id || 'user' %>/workspace">
            <div class="form-text">Path relative to your workspace root. Use <code>~/</code> for home directory.</div>
          </div>
          <div class="form-group">
            <label class="form-label" for="terminalShell">Shell</label>
            <select class="form-select" id="terminalShell" name="shell">
              <option value="bash">Bash</option>
              <option value="zsh">Zsh</option>
              <option value="fish">Fish</option>
              <option value="sh">Sh</option>
              <option value="powershell">PowerShell</option>
              <option value="cmd">Command Prompt</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label" for="terminalCols">Columns</label>
            <input type="number" class="form-control" id="terminalCols" name="cols" value="120" min="40" max="300">
          </div>
          <div class="form-group">
            <label class="form-label" for="terminalRows">Rows</label>
            <input type="number" class="form-control" id="terminalRows" name="rows" value="30" min="10" max="100">
          </div>
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="terminalAudited" name="audited" value="1" checked>
            <label class="form-check-label" for="terminalAudited">Enable session auditing (commands logged)</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Create Terminal</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Session History Modal -->
<div class="modal fade" id="sessionHistoryModal" tabindex="-1" aria-labelledby="sessionHistoryModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="sessionHistoryModalLabel">Session History</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="table-wrap">
          <table class="data-table" id="historyTable">
            <thead>
              <tr>
                <th>Session</th>
                <th>Working Dir</th>
                <th>Shell</th>
                <th>Started</th>
                <th>Duration</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="historyBody">
              <tr><td colspan="7" class="text-center text-muted">Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<% if (typeof csrfToken !== 'undefined') { %>
<script>
  window.csrfToken = '<%= csrfToken %>';
</script>
<% } %>

<script src="/public/js/terminal.js"></script>