<div class="page-header">
  <div>
    <h1 class="page-title">Notifications</h1>
    <p class="page-subtitle">Everything happening on your panel</p>
  </div>
  <div class="page-actions">
    <form action="/notifications/read-all" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-secondary">Mark all as read</button>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (!notifications || !notifications.length) { %>
      <div class="empty-state">
        <div class="empty-icon">◔</div>
        <h3>You're all caught up</h3>
        <p>New events will appear here as they happen.</p>
      </div>
    <% } else { %>
      <div class="activity-list">
        <% notifications.forEach(function(n) { %>
          <div class="activity-item">
            <span class="activity-icon">●</span>
            <div class="activity-body">
              <div class="activity-title"><%= n.title %></div>
              <div class="activity-meta"><%= n.message %> · <%= n.timeAgo %></div>
            </div>
            <div class="btn-group">
              <% if (!n.is_read) { %>
                <form action="/notifications/<%= n.id %>/read" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-secondary btn-sm">Mark read</button>
                </form>
              <% } %>
              <form action="/notifications/<%= n.id %>/delete" method="POST" data-confirm="Delete this notification?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
              </form>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
