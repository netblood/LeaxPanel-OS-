<%- include('../partials/head'); %>
<title>Domains - LEAXOS</title>
<body>
  <%- include('../partials/navbar'); %>
  <main class="container">
    <%- include('../partials/flash'); %>
    <h1>Domains</h1>
    <table>
      <thead>
        <tr><th>ID</th><th>Domain</th><th>Status</th><th>Created</th></tr>
      </thead>
      <tbody>
        <% domains.forEach(function(domain) { %>
          <tr>
            <td><%= domain.id %></td>
            <td><%= domain.name %></td>
            <td><%= domain.status %></td>
            <td><%= domain.created_at %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
  <script src="/js/main.js"></script>
</body>
