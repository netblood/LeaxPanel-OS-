<div class="page-header">
  <div>
    <h1 class="page-title">File Manager</h1>
    <p class="page-subtitle">Upload, edit, move and archive your files</p>
  </div>
  <div class="page-actions">
    <form action="/file-manager/mkdir" method="POST" class="inline-form" data-loading>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="dir" value="<%= currentPath %>">
      <input class="form-control" type="text" name="name" placeholder="New folder" style="width:160px;height:38px;">
      <button type="submit" class="btn btn-secondary">New folder</button>
    </form>
    <form action="/file-manager/upload" method="POST" enctype="multipart/form-data" class="inline-form" data-loading>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="path" value="<%= currentPath %>">
      <input type="file" name="files" multiple class="form-control" style="width:auto;padding:6px 10px;">
      <button type="submit" class="btn btn-primary">Upload</button>
    </form>
  </div>
</div>

<div class="card" style="margin-bottom:var(--sp-4);">
  <div class="card-body">
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
      <a href="/file-manager" class="btn btn-secondary btn-sm"><svg width="16" height="16" style="color:#cbd5e1;vertical-align:middle"><use href="#icon-home"/></svg> Root</a>
      <% breadcrumbs.forEach(function(crumb) { %>
        <span class="text-muted">/</span>
        <a href="/file-manager?path=<%= encodeURIComponent(crumb.path) %>" class="btn btn-ghost btn-sm"><%= crumb.name %></a>
      <% }); %>
      <span style="margin-left:auto;" class="text-muted text-sm"><%= entries.length %> item(s)</span>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (!entries || !entries.length) { %>
      <div class="empty-state">
        <div class="empty-icon">◇</div>
        <h3>This folder is empty</h3>
        <p>Upload files or create a new folder to get started.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th style="width:34px;"><input type="checkbox" data-table-select-all aria-label="Select all"></th>
              <th>Name</th>
              <th>Type</th>
              <th>Size</th>
              <th>Modified</th>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% entries.forEach(function(entry) { %>
              <tr>
                <td><input type="checkbox" data-row-check aria-label="Select row"></td>
                <td class="cell-primary">
                  <% if (entry.isDir) { %>
                    <a href="/file-manager?path=<%= encodeURIComponent(entry.path) %>"><svg width="16" height="16" style="color:#cbd5e1;vertical-align:middle"><use href="#icon-folder"/></svg> <%= entry.name %></a>
                  <% } else { %>
                    <svg width="16" height="16" style="color:#94a3b8;vertical-align:middle"><use href="#icon-file-text"/></svg> <%= entry.name %>
                  <% } %>
                </td>
                <td><span class="badge badge-info badge-plain"><%= entry.isDir ? 'Folder' : 'File' %></span></td>
                <td><%= entry.sizeLabel %></td>
                <td><%= entry.modifiedLabel %></td>
                <td class="col-actions">
                  <div class="btn-group">
                    <% if (!entry.isDir) { %>
                      <a href="/file-manager/edit?path=<%= encodeURIComponent(entry.path) %>" class="btn btn-secondary btn-sm">Edit</a>
                      <a href="/file-manager/download?path=<%= encodeURIComponent(entry.path) %>" class="btn btn-secondary btn-sm">Download</a>
                    <% } %>
                    <form action="/file-manager/zip" method="POST">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="path" value="<%= entry.path %>">
                      <input type="hidden" name="dir" value="<%= currentPath %>">
                      <button type="submit" class="btn btn-secondary btn-sm">Zip</button>
                    </form>
                    <form action="/file-manager/delete" method="POST" data-confirm="Delete <%= entry.name %>? This cannot be undone.">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <input type="hidden" name="path" value="<%= entry.path %>">
                      <input type="hidden" name="dir" value="<%= currentPath %>">
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
