<div class="page-header">
  <div>
    <h1 class="page-title">Service Hub</h1>
    <p class="page-subtitle">Deploy and manage all your services from one place</p>
  </div>
  <div class="page-actions">
    <a href="/services/create" class="btn btn-primary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
      New Service
    </a>
  </div>
</div>

<div class="service-categories">
  <% const categories = [
    {
      id: 'websites',
      label: 'Websites',
      icon: 'globe',
      description: 'WordPress, WooCommerce, PHP, Laravel, Static sites',
      services: [
        { id: 'wordpress', name: 'WordPress', description: 'CMS, blogs, business sites', icon: 'file-text', template: 'wordpress-starter' },
                { id: 'woocommerce', name: 'WooCommerce', description: 'E-commerce stores', icon: 'shopping-cart', template: 'woocommerce-starter' },
                { id: 'php', name: 'PHP Application', description: 'Laravel, Symfony, CodeIgniter', icon: 'file-text', template: 'php-starter' },
                { id: 'laravel', name: 'Laravel', description: 'Modern PHP framework', icon: 'triangle', template: 'laravel-starter' },
                { id: 'static', name: 'Static Site', description: 'HTML, React, Vue, Next.js export', icon: 'file', template: 'html-starter' }
      ]
    },
    {
      id: 'apps',
      label: 'Applications',
      icon: 'package',
      description: 'NodeJS, Express, NestJS, Fastify, Go, Python, Docker',
      services: [
        { id: 'nodejs', name: 'NodeJS', description: 'JavaScript runtime', icon: 'package', template: 'nodejs-starter' },
                { id: 'express', name: 'Express', description: 'Fast, unopinionated web framework', icon: 'server', template: 'express-starter' },
                { id: 'nestjs', name: 'NestJS', description: 'Scalable Node.js framework', icon: 'git-branch', template: 'nestjs-starter' },
                { id: 'fastify', name: 'Fastify', description: 'Fast and low overhead', icon: 'zap', template: 'fastify-starter' },
                { id: 'go', name: 'Go Application', description: 'Golang services', icon: 'code-2', template: 'go-starter' },
                { id: 'python', name: 'Python Application', description: 'FastAPI, Flask, Django', icon: 'file-text', template: 'python-starter' },
                { id: 'docker', name: 'Docker Container', description: 'Any containerized app', icon: 'layers', template: 'docker-starter' }
      ]
    },
    {
      id: 'bots',
      label: 'Bots',
      icon: 'bot',
      description: 'Telegram, Discord, WhatsApp, Slack bots',
      services: [
        { id: 'telegram', name: 'Telegram Bot', description: 'BotFather integration', icon: 'send', template: 'telegram-bot-starter' },
                { id: 'discord', name: 'Discord Bot', description: 'Gateway & REST API', icon: 'chat', template: 'discord-bot-starter' },
                { id: 'whatsapp', name: 'WhatsApp', description: 'Evolution API / WAHA / Baileys', icon: 'phone', template: 'whatsapp-starter' },
                { id: 'slack', name: 'Slack Bot', description: 'Bolt framework', icon: 'message-circle', template: 'slack-bot-starter' }
      ]
    },
    {
      id: 'ai-agents',
      label: 'AI Agents',
      icon: 'brain',
      description: 'Support, DevOps, Security, Marketing, Sales, Coding agents',
      services: [
        { id: 'support-agent', name: 'Support Agent', description: 'Customer support automation', icon: 'headphones', template: 'support-agent-starter' },
                { id: 'devops-agent', name: 'DevOps Agent', description: 'Infrastructure automation', icon: 'settings', template: 'devops-agent-starter' },
                { id: 'security-agent', name: 'Security Agent', description: 'Threat detection & response', icon: 'shield', template: 'security-agent-starter' },
                { id: 'marketing-agent', name: 'Marketing Agent', description: 'Content & campaigns', icon: 'megaphone', template: 'marketing-agent-starter' },
                { id: 'sales-agent', name: 'Sales Agent', description: 'Lead qualification & outreach', icon: 'briefcase', template: 'sales-agent-starter' },
                { id: 'coding-agent', name: 'Developer Agent', description: 'Code generation & review', icon: 'terminal-square', template: 'coding-agent-starter' }
      ]
    },
    {
      id: 'workflows',
      label: 'Workflows',
      icon: 'workflow',
      description: 'N8N automation workflows',
      services: [
        { id: 'n8n', name: 'N8N', description: 'Visual workflow automation', icon: 'workflow', template: 'n8n-starter' }
      ]
    },
    {
      id: 'databases',
      label: 'Databases',
      icon: 'database',
      description: 'PostgreSQL, MySQL, MongoDB, Redis, SQLite',
      services: [
        { id: 'postgresql', name: 'PostgreSQL', description: 'Advanced open source DB', icon: 'database', template: 'postgresql-starter' },
                { id: 'mysql', name: 'MySQL', description: 'Popular relational DB', icon: 'database', template: 'mysql-starter' },
                { id: 'mongodb', name: 'MongoDB', description: 'Document database', icon: 'database', template: 'mongodb-starter' },
                { id: 'redis', name: 'Redis', description: 'In-memory data store', icon: 'circle', template: 'redis-starter' },
                { id: 'sqlite', name: 'SQLite', description: 'Embedded database', icon: 'diamond', template: 'sqlite-starter' }
      ]
    },
    {
      id: 'email',
      label: 'Email',
      icon: 'mail',
      description: 'SMTP, IMAP, Gmail, Outlook, Custom providers',
      services: [
        { id: 'email', name: 'Email Account', description: 'Mailbox with IMAP/SMTP', icon: 'mail', template: 'email-starter' }
      ]
    },
    {
      id: 'storage',
      label: 'Storage',
      icon: 'hard-drive',
      description: 'Object storage, S3 compatible, local buckets',
      services: [
        { id: 'storage', name: 'Storage Bucket', description: 'S3-compatible object storage', icon: 'hard-drive', template: 'storage-starter' }
      ]
    },
    {
      id: 'domains',
      label: 'Domains',
      icon: 'globe-2',
      description: 'Domain registration, DNS management, SSL certificates',
      services: [
        { id: 'domain', name: 'Domain', description: 'Register & manage domains', icon: 'globe-2', template: 'domain-starter' }
      ]
    }
  ]; %>

  <% categories.forEach(function(category) { %>
    <section class="service-category" id="category-<%= category.id %>">
      <div class="category-header">
        <div class="category-title">
                  <span class="category-icon"><svg width="20" height="20" style="color:#cbd5e1"><use href="#icon-<%= category.icon %>"/></svg></span>
          <div>
            <h2><%= category.label %></h2>
            <p class="category-description"><%= category.description %></p>
          </div>
        </div>
        <a href="/<%= category.id %>" class="btn btn-ghost btn-sm">View all</a>
      </div>

      <div class="service-grid">
        <% category.services.forEach(function(service) { %>
          <article class="service-card" data-service="<%= service.id %>" data-template="<%= service.template %>">
            <div class="service-card-icon"><svg width="20" height="20" style="color:#cbd5e1"><use href="#icon-<%= service.icon %>"/></svg></div>
            <div class="service-card-body">
              <h3 class="service-card-name"><%= service.name %></h3>
              <p class="service-card-desc"><%= service.description %></p>
            </div>
            <div class="service-card-actions">
              <a href="/<%= category.id %>/create?type=<%= service.id %>" class="btn btn-primary btn-sm">Deploy</a>
              <button class="btn btn-ghost btn-sm preview-template" data-template="<%= service.template %>">Preview</button>
            </div>
          </article>
        <% }); %>
      </div>
    </section>
  <% }); %>
</div>

<!-- Template Preview Modal -->
<div class="modal" id="templatePreviewModal" hidden role="dialog" aria-labelledby="templateModalTitle" aria-modal="true">
  <div class="modal-overlay"></div>
  <div class="modal-container modal-lg">
    <div class="modal-header">
      <h3 id="templateModalTitle">Template Preview</h3>
      <button class="modal-close" aria-label="Close">&times;</button>
    </div>
    <div class="modal-body" id="templateModalBody">
      <div class="text-center text-muted">Loading preview...</div>
    </div>
    <div class="modal-footer">
      <a href="#" id="templateDeployBtn" class="btn btn-primary">Deploy this template</a>
      <button class="btn btn-ghost modal-close">Close</button>
    </div>
  </div>
</div>

<style>
.service-categories {
  display: flex;
  flex-direction: column;
  gap: var(--sp-8);
}

.service-category {
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-lg);
  overflow: hidden;
}

.category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--sp-5) var(--sp-6);
  border-bottom: 1px solid var(--border);
  background: var(--surface-2);
}

.category-title {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
}

.category-icon {
  font-size: 28px;
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-soft);
  border-radius: var(--r-md);
}

.category-title h2 {
  font-size: 18px;
  font-weight: 700;
  margin: 0;
  color: var(--text);
}

.category-description {
  margin: 2px 0 0;
  font-size: 13px;
  color: var(--text-3);
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: var(--sp-4);
  padding: var(--sp-5) var(--sp-6);
}

.service-card {
  display: flex;
  align-items: center;
  gap: var(--sp-4);
  padding: var(--sp-4);
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: var(--r-md);
  transition: all var(--t-fast);
}

.service-card:hover {
  border-color: var(--primary);
  box-shadow: var(--shadow);
  transform: translateY(-2px);
}

.service-card-icon {
  font-size: 32px;
  width: 56px;
  height: 56px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2);
  border-radius: var(--r-md);
  flex-shrink: 0;
}

.service-card-body {
  flex: 1;
  min-width: 0;
}

.service-card-name {
  font-size: 15px;
  font-weight: 600;
  margin: 0 0 4px;
  color: var(--text);
}

.service-card-desc {
  font-size: 12px;
  color: var(--text-3);
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.service-card-actions {
  display: flex;
  gap: var(--sp-2);
  flex-shrink: 0;
}

@media (max-width: 640px) {
  .service-card {
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .service-card-icon {
    width: 48px;
    height: 48px;
    font-size: 24px;
  }
  .service-card-actions {
    width: 100%;
    justify-content: flex-end;
  }
}
</style>

<script>
(function() {
  'use strict';

  const modal = document.getElementById('templatePreviewModal');
  const modalBody = document.getElementById('templateModalBody');
  const modalTitle = document.getElementById('templateModalTitle');
  const deployBtn = document.getElementById('templateDeployBtn');

  if (!modal) return;

  function openModal(templateName, serviceName, category) {
    modalTitle.textContent = `${serviceName} - Template Preview`;
    modalBody.innerHTML = '<div class="text-center text-muted" style="padding:var(--sp-8);">Loading preview...</div>';
    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    // Fetch template preview
    fetch(`/api/templates/${templateName}/preview`)
      .then(r => r.ok ? r.json() : Promise.reject(r))
      .then(data => {
        modalBody.innerHTML = data.html || '<div class="text-center text-muted">Preview not available</div>';
        deployBtn.href = `/${category}/create?type=${templateName.replace('-starter', '')}`;
      })
      .catch(() => {
        modalBody.innerHTML = '<div class="text-center text-muted" style="padding:var(--sp-8);">Preview not available for this template</div>';
      });
  }

  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  modal.querySelector('.modal-overlay').addEventListener('click', closeModal);
  modal.querySelectorAll('.modal-close').forEach(btn => btn.addEventListener('click', closeModal));

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  document.querySelectorAll('.preview-template').forEach(btn => {
    btn.addEventListener('click', e => {
      e.preventDefault();
      const card = btn.closest('.service-card');
      if (card) {
        const template = card.dataset.template;
        const serviceName = card.querySelector('.service-card-name').textContent;
        const category = card.closest('.service-category').id.replace('category-', '');
        openModal(template, serviceName, category);
      }
    });
  });
})();
</script>