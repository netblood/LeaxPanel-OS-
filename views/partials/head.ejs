<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="description" content="LeaxPanel - Cloud Platform Operating System. Host anything, manage everything, deploy anywhere.">
<meta name="theme-color" content="#0a0b14">
<meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
<title><%= typeof title !== 'undefined' && title ? title : 'LeaxPanel' %> · <%= (typeof panelSettings !== 'undefined' && panelSettings && panelSettings.panel_name) ? panelSettings.panel_name : 'LeaxPanel' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<!-- HTMX -->
<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.0"></script>
<link rel="stylesheet" href="/css/style.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '1.0.0' %>">
<link rel="icon" type="image/png" href="/images/logo.png">
<!-- Lucide SVG icon sprite (single icon system) -->
<%- include('icons'); %>
<!-- xterm.js for browser terminal -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
<script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-webgl@0.16.0/lib/xterm-addon-webgl.js"></script>

<!-- Monaco Editor for file manager -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/monaco-editor@0.47.0/min/vs/editor/editor.main.css" />
<script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.47.0/min/vs/loader.js"></script>
