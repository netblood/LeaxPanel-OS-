<%
  // Generic resource form renderer.
  // Expects: fields (array), values (object), action, submitLabel, cancelHref, module
  // NOTE: `include(path, locals)` injects locals via `with()`, so no local name
  // passed in may be redeclared with const/let in this partial.
  const formFields = typeof fields !== 'undefined' && fields ? fields : [];
  const formValues = typeof values !== 'undefined' && values ? values : {};
  const formAction = typeof action !== 'undefined' ? action : '';
  const btnLabel = typeof submitLabel !== 'undefined' ? submitLabel : 'Save';
  const cancelLink = typeof cancelHref !== 'undefined' ? cancelHref : (typeof module !== 'undefined' ? '/' + module : '/dashboard');
  const val = (f) => {
    const v = formValues ? formValues[f.name] : '';
    return v === null || v === undefined ? '' : v;
  };
%>
<form action="<%= formAction %>" method="POST" class="card" data-loading>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <div class="form-grid">
      <% formFields.forEach(function(f) { %>
        <div class="form-group <%= f.span ? 'span-2' : '' %>">
          <label class="form-label" for="field-<%= f.name %>">
            <%= f.label %><% if (f.required) { %><span class="req">*</span><% } %>
          </label>

          <% if (f.type === 'textarea') { %>
            <textarea class="form-control" id="field-<%= f.name %>" name="<%= f.name %>"
                      placeholder="<%= f.placeholder || '' %>"
                      <%= f.readonly ? 'readonly' : '' %>><%= val(f) %></textarea>

          <% } else if (f.type === 'select') { %>
            <select class="form-control" id="field-<%= f.name %>" name="<%= f.name %>" <%= f.readonly ? 'disabled' : '' %>>
              <% if (!f.required) { %><option value="">— Select —</option><% } %>
              <% (f.options || []).forEach(function(opt) { %>
                <option value="<%= opt %>" <%= String(val(f)) === String(opt) ? 'selected' : '' %>><%= opt %></option>
              <% }); %>
            </select>

          <% } else if (f.type === 'checkbox') { %>
            <label class="form-check">
              <input type="checkbox" id="field-<%= f.name %>" name="<%= f.name %>" <%= val(f) ? 'checked' : '' %>>
              <span><%= f.checkboxLabel || f.label %></span>
            </label>

          <% } else { %>
            <input class="form-control" type="<%= f.type || 'text' %>" id="field-<%= f.name %>" name="<%= f.name %>"
                   value="<%= val(f) %>"
                   placeholder="<%= f.placeholder || '' %>"
                   <%= f.required ? 'required' : '' %>
                   <%= f.readonly ? 'readonly' : '' %>>
          <% } %>

          <% if (f.help) { %><span class="form-hint"><%= f.help %></span><% } %>
        </div>
      <% }); %>
    </div>
  </div>
  <div class="card-footer form-actions">
    <button type="submit" class="btn btn-primary"><%= btnLabel %></button>
    <a href="<%= cancelLink %>" class="btn btn-ghost">Cancel</a>
  </div>
</form>
