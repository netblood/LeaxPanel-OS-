<%
  const panelName = (typeof panelSettings !== 'undefined' && panelSettings && panelSettings.panel_name) ? panelSettings.panel_name : 'LeaxPanel';
  const footerText = (typeof panelSettings !== 'undefined' && panelSettings && panelSettings.footer_text) ? panelSettings.footer_text : 'Hosted & powered by LeaxPanel(os)';
  const resolvedAppVersion = typeof appVersion !== 'undefined' && appVersion ? appVersion : '1.0.0';
%>
<footer class="app-footer">
  <div class="app-footer-left">
    <span class="app-footer-brand">&copy; <%= new Date().getFullYear() %> <%= panelName %></span>
    <span class="app-footer-sep">&bull;</span>
    <span><%= footerText %></span>
  </div>
  <div class="app-footer-right">
    <a href="/setup" class="app-footer-link">Setup</a>
    <a href="/doctor" class="app-footer-link">Doctor</a>
    <a href="/health" class="app-footer-link">Status</a>
    <a href="https://github.com/netblood/LeaxPanel-OS-" target="_blank" rel="noopener" class="app-footer-link">GitHub</a>
    <span class="app-footer-version">v<%= resolvedAppVersion %></span>
  </div>
</footer>
