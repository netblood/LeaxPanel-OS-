<header class="topbar">
  <div class="topbar-left">
    <button class="icon-btn mobile-menu" id="mobileMenu" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <a href="/dashboard" class="topbar-brand">
      <img src="/images/logo.png" alt="<%= (typeof panelSettings !== 'undefined' && panelSettings ? panelSettings.panel_name : 'LeaxPanel') %>" class="topbar-brand-logo">
      <span class="topbar-brand-name"><strong><%= (typeof panelSettings !== 'undefined' && panelSettings ? panelSettings.panel_name : 'LeaxPanel') %></strong></span>
    </a>

    <div class="breadcrumb">
      <a href="/dashboard">Home</a>
      <span class="breadcrumb-sep">/</span>
      <span class="breadcrumb-current"><%= typeof pageTitle !== 'undefined' && pageTitle ? pageTitle : (typeof title !== 'undefined' ? title : 'Dashboard') %></span>
    </div>
  </div>

  <div class="topbar-right">
    <div class="global-search" role="search">
      <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="search" id="globalSearch" placeholder="Search resources..." autocomplete="off" aria-label="Global search">
      <kbd class="search-kbd">Ctrl K</kbd>
      <div class="search-results" id="searchResults" hidden></div>
    </div>

    <div class="topbar-dropdown quick-create-dropdown">
      <button class="btn btn-primary btn-sm quick-create-btn" id="quickCreateBtn" aria-label="Quick Create" aria-expanded="false" aria-controls="quickCreatePanel">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        <span class="hide-sm">Quick Create</span>
        <svg class="dropdown-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div class="dropdown-panel quick-create-panel" id="quickCreatePanel" hidden role="menu" aria-label="Quick Create">
        <div class="dropdown-header">
          <strong>Quick Create</strong>
          <input type="search" id="quickCreateSearch" placeholder="Search actions..." autocomplete="off" aria-label="Filter quick create actions">
        </div>
        <div class="dropdown-body quick-create-grid" id="quickCreateGrid" role="listbox">
          <% const quickActions = [
            { label: 'Create Website', href: '/website/create', icon: 'globe', desc: 'Deploy a new website' },
            { label: 'Create WordPress', href: '/apps/create?type=wordpress', icon: 'file-text', desc: 'Deploy WordPress site' },
            { label: 'Create WooCommerce', href: '/apps/create?type=woocommerce', icon: 'shopping-cart', desc: 'Deploy WooCommerce store' },
            { label: 'Create NodeJS App', href: '/apps/create?type=nodejs', icon: 'package', desc: 'Deploy Node.js application' },
            { label: 'Create PHP App', href: '/apps/create?type=php', icon: 'file', desc: 'Deploy PHP application' },
            { label: 'Create Telegram Bot', href: '/telegram/create', icon: 'send', desc: 'Deploy Telegram bot' },
            { label: 'Create Discord Bot', href: '/discord/create', icon: 'message-circle', desc: 'Deploy Discord bot' },
            { label: 'Create WhatsApp Instance', href: '/whatsapp/create', icon: 'phone', desc: 'Connect WhatsApp' },
            { label: 'Create AI Agent', href: '/ai/create', icon: 'brain', desc: 'Deploy AI agent' },
            { label: 'Create n8n Workflow', href: '/n8n/create', icon: 'workflow', desc: 'Create automation workflow' },
            { label: 'Create Database', href: '/databases/create', icon: 'database', desc: 'Create new database' },
            { label: 'Create Domain', href: '/domains/create', icon: 'globe-2', desc: 'Add new domain' },
            { label: 'Create Email', href: '/email/create', icon: 'mail', desc: 'Create email account' },
            { label: 'Create Backup', href: '/backups/create', icon: 'archive-restore', desc: 'Create new backup' }
          ]; %>
          <% quickActions.forEach(function(action) { %>
            <a href="<%= action.href %>" class="quick-create-item" role="option" title="<%= action.desc %>">
              <span class="quick-create-item-icon">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <use href="#icon-<%= action.icon %>"></use>
                </svg>
              </span>
              <span class="quick-create-item-label"><%= action.label %></span>
            </a>
          <% }); %>
        </div>
      </div>
    </div>

    <button class="icon-btn" id="themeToggle" title="Toggle theme" aria-label="Toggle theme">
      <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <circle cx="12" cy="12" r="5"></circle>
        <line x1="12" y1="1" x2="12" y2="3"></line>
        <line x1="12" y1="21" x2="12" y2="23"></line>
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
        <line x1="1" y1="12" x2="3" y2="12"></line>
        <line x1="21" y1="12" x2="23" y2="12"></line>
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
      </svg>
      <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <div class="topbar-dropdown">
      <button class="icon-btn" id="notificationBtn" title="Notifications" aria-label="Notifications">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
          <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
        </svg>
        <% if (typeof unreadNotifications !== 'undefined' && unreadNotifications > 0) { %>
          <span class="notif-badge"><%= unreadNotifications > 99 ? '99+' : unreadNotifications %></span>
        <% } %>
      </button>
      <div class="dropdown-panel notification-panel" id="notificationPanel" hidden>
        <div class="dropdown-header">
          <strong>Notifications</strong>
          <a href="/notifications" class="link-sm">View all</a>
        </div>
        <div class="dropdown-body">
          <% if (typeof notifications !== 'undefined' && notifications && notifications.length) { %>
            <% notifications.forEach(function(n) { %>
              <a href="<%= n.link || '/notifications' %>" class="notif-item">
                <span class="notif-icon notif-<%= n.type || 'info' %>"></span>
                <span class="notif-body">
                  <strong><%= n.title %></strong>
                  <small><%= n.message %></small>
                </span>
                <span class="notif-time"><%= n.timeAgo || '' %></span>
              </a>
            <% }); %>
          <% } else { %>
            <div class="dropdown-empty">
              <span class="notif-icon notif-info"></span>
              <p>You're all caught up</p>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <div class="topbar-dropdown">
      <button class="user-chip" id="userMenuBtn">
        <span class="avatar"><%= (user && user.name ? user.name : 'U').charAt(0).toUpperCase() %></span>
        <span class="user-meta hide-md">
          <strong><%= user && user.name ? user.name : 'User' %></strong>
          <small><%= user && user.role ? user.role : 'user' %></small>
        </span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </button>
      <div class="dropdown-panel user-panel" id="userMenu" hidden>
        <div class="dropdown-header">
          <strong><%= user && user.email ? user.email : '' %></strong>
        </div>
        <div class="dropdown-body">
          <a href="/profile" class="dropdown-item">My Profile</a>
          <a href="/settings" class="dropdown-item">Settings</a>
          <a href="/apikeys" class="dropdown-item">API Keys</a>
          <a href="/notifications" class="dropdown-item">Notifications</a>
          <a href="/white-label" class="dropdown-item">White Label</a>
          <div class="dropdown-divider"></div>
          <form action="/logout" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="dropdown-item danger" style="width:100%;background:none;border:none;text-align:left;cursor:pointer;">Sign Out</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</header>
