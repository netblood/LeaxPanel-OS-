<div class="page-header">
  <div>
    <h1 class="page-title">Create user</h1>
    <p class="page-subtitle">Invite a new account to your panel</p>
  </div>
  <div class="page-actions">
    <a href="/users" class="btn btn-ghost">Back to users</a>
  </div>
</div>

<form action="/users/create" method="POST" class="card" data-loading>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label" for="name">Full name<span class="req">*</span></label>
        <input class="form-control" type="text" id="name" name="name" placeholder="Bilal Chentouf" required autofocus>
      </div>
      <div class="form-group">
        <label class="form-label" for="email">Email address<span class="req">*</span></label>
        <input class="form-control" type="email" id="email" name="email" placeholder="user@example.com" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="role">Role<span class="req">*</span></label>
        <select class="form-control" id="role" name="role" required>
          <% roles.forEach(function(r) { %>
            <option value="<%= r.name %>" <%= r.name === 'user' ? 'selected' : '' %>><%= r.display_name %></option>
          <% }); %>
        </select>
        <span class="form-hint">Roles control which modules are visible and what actions are permitted.</span>
      </div>
      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" type="password" id="password" name="password" placeholder="Leave blank to auto-generate" minlength="8">
        <span class="form-hint">Minimum 8 characters. Leave empty to generate a temporary password.</span>
      </div>
    </div>
  </div>
  <div class="card-footer form-actions">
    <button type="submit" class="btn btn-primary">Create user</button>
    <a href="/users" class="btn btn-ghost">Cancel</a>
  </div>
</form>
