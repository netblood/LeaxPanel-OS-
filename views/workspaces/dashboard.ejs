<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%- include('../partials/head', { title: (typeof activeWorkspace !== 'undefined' && activeWorkspace ? activeWorkspace.name + ' Dashboard' : 'Dashboard'), pageId: 'dashboard' }) %>
</head>
<body class="dashboard-page">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/topbar') %>

  <main class="main-content" id="mainContent">
    <div class="page-header">
      <div class="page-header-left">
        <div class="workspace-breadcrumb">
          <% if (userWorkspaces && userWorkspaces.length > 1) { %>
            <select class="workspace-select" id="workspaceSelect">
              <% userWorkspaces.forEach(function(ws) { %>
                <option value="<%= ws.id %>" <%= ws.id === activeWorkspace?.id ? 'selected' : '' %>>
                  <%= ws.name %> (<%= ws.type %>)
                </option>
              <% }); %>
            </select>
          <% } else if (activeWorkspace) { %>
            <span class="workspace-name">
              <span class="workspace-type-badge" style="background: <%= workspaceTypes[activeWorkspace.type]?.color || '#8b5cf6' %>">
                              <svg width="14" height="14" style="color:#fff"><use href="#icon-<%= workspaceTypes[activeWorkspace.type]?.icon || 'folder' %>"/></svg>
              </span>
              <%= activeWorkspace.name %>
            </span>
          <% } %>
        </div>
        <h1 class="page-title"><%= activeWorkspace?.name || 'Dashboard' %></h1>
        <p class="page-subtitle"><%= activeWorkspace?.description || 'Workspace overview' %></p>
      </div>
      <div class="page-header-right">
        <% if (typeof workspaceMember !== 'undefined' && workspaceMember && (workspaceMember.role === 'owner' || workspaceMember.role === 'admin')) { %>
          <a href="/workspaces/<%= activeWorkspace.id %>/settings" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="3"></circle>
              <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path>
            </svg>
            Settings
          </a>
        <% } %>
        <a href="/workspaces/<%= activeWorkspace.id %>/members" class="btn btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
            <circle cx="9" cy="7" r="4"></circle>
            <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
          </svg>
          Members
        </a>
      </div>
    </div>

    <!-- Quick Stats -->
    <div class="stats-grid">
      <% if (dashboardData?.summary) { %>
        <div class="stat-card">
          <div class="stat-icon" style="background: #3b82f6"><svg width="16" height="16" style="color:#fff"><use href="#icon-globe"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.websites || 0 %></div>
            <div class="stat-label">Websites</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #8b5cf6"><svg width="16" height="16" style="color:#fff"><use href="#icon-package"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.apps || 0 %></div>
            <div class="stat-label">Applications</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #06b6d4"><svg width="16" height="16" style="color:#fff"><use href="#icon-globe-2"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.domains || 0 %></div>
            <div class="stat-label">Domains</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #10b981"><svg width="16" height="16" style="color:#fff"><use href="#icon-database"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.databases || 0 %></div>
            <div class="stat-label">Databases</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #f59e0b"><svg width="16" height="16" style="color:#fff"><use href="#icon-bot"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.bots || 0 %></div>
            <div class="stat-label">Bots</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #ec4899"><svg width="16" height="16" style="color:#fff"><use href="#icon-settings"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.workflows || 0 %></div>
            <div class="stat-label">Workflows</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #6366f1"><svg width="16" height="16" style="color:#fff"><use href="#icon-brain"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.aiAgents || 0 %></div>
            <div class="stat-label">AI Agents</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #ef4444"><svg width="16" height="16" style="color:#fff"><use href="#icon-hard-drive"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.backups || 0 %></div>
            <div class="stat-label">Backups</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #84cc16"><svg width="16" height="16" style="color:#fff"><use href="#icon-folder"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.storageBuckets || 0 %></div>
            <div class="stat-label">Storage</div>
          </div>
        </div>
        <div class="stat-card">
          <div class="stat-icon" style="background: #0ea5e9"><svg width="16" height="16" style="color:#fff"><use href="#icon-mail"/></svg></div>
          <div class="stat-info">
            <div class="stat-value"><%= dashboardData.summary.emailAccounts || 0 %></div>
            <div class="stat-label">Emails</div>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Service Cards Grid -->
    <div class="dashboard-grid">
      <% if (dashboardData?.serviceCards && dashboardData.serviceCards.length > 0) { %>
        <% dashboardData.serviceCards.forEach(function(card) { %>
          <div class="card service-card" data-service="<%= card.serviceType %>">
            <div class="card-header">
              <div class="card-title-row">
                <h3 class="card-title">
                  <span class="service-icon" style="background: <%= card.color %>"><svg width="18" height="18" aria-hidden="true"><use href="#icon-<%= card.icon || 'package' %>"></use></svg></span>
                  <%= card.label %>
                </h3>
                <span class="card-count badge"><%= card.count %></span>
              </div>
              <p class="card-description"><%= card.description %></p>
            </div>
            <div class="card-body">
              <% if (card.stats) { %>
                <div class="service-stats">
                  <% Object.entries(card.stats).forEach(function([key, value]) { %>
                    <div class="stat-mini">
                      <span class="stat-mini-label"><%= key %></span>
                      <span class="stat-mini-value"><%= value %></span>
                    </div>
                  <% }); %>
                </div>
              <% } %>
              <% if (card.items && card.items.length > 0) { %>
                <div class="service-items">
                  <% card.items.slice(0, 3).forEach(function(item) { %>
                    <div class="service-item">
                      <div class="service-item-info">
                        <div class="service-item-name"><%= item.name %></div>
                        <div class="service-item-meta"><%= item.meta || '' %></div>
                      </div>
                      <span class="service-item-status <%= item.status %>"><%= item.status %></span>
                    </div>
                  <% }); %>
                  <% if (card.items.length > 3) { %>
                    <div class="service-item-more">+<%= card.items.length - 3 %> more</div>
                  <% } %>
                </div>
              <% } else { %>
                <div class="service-empty">
                  <p>No <%= card.label.toLowerCase() %> yet</p>
                  <% if (card.createAction) { %>
                    <a href="<%= card.createAction.href %>" class="btn btn-sm btn-primary">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                      <%= card.createAction.label %>
                    </a>
                  <% } %>
                </div>
              <% } %>
            </div>
            <div class="card-footer">
              <a href="<%= card.href %>" class="btn btn-ghost btn-sm">View All</a>
              <% if (card.quickActions && card.quickActions.length > 0) { %>
                <div class="quick-actions">
                  <% card.quickActions.forEach(function(action) { %>
                    <a href="<%= action.href %>" class="btn btn-ghost btn-sm" title="<%= action.tooltip %>">
                      <svg width="14" height="14" aria-hidden="true"><use href="#icon-<%= action.icon || 'plus' %>"></use></svg>
                    </a>
                  <% }); %>
                </div>
              <% } %>
            </div>
          </div>
        <% }); %>
      <% } else { %>
        <div class="card empty-state">
          <div class="empty-icon"><svg width="28" height="28" style="color:#cbd5e1"><use href="#icon-package"/></svg></div>
          <h3>No Services Assigned</h3>
          <p>This workspace doesn't have any services assigned yet.</p>
          <% if (typeof workspaceMember !== 'undefined' && workspaceMember && (workspaceMember.role === 'owner' || workspaceMember.role === 'admin')) { %>
            <a href="/workspaces/<%= activeWorkspace.id %>/services" class="btn btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              Assign Services
            </a>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Resource Usage -->
    <% if (dashboardData?.resourceUsage && dashboardData.resourceUsage.length > 0) { %>
      <div class="card resource-usage-card">
        <div class="card-header">
          <h3 class="card-title">
            <span class="card-icon"><svg width="14" height="14" style="color:#cbd5e1"><use href="#icon-bar-chart-2"/></svg></span>
            Resource Usage
          </h3>
        </div>
        <div class="card-body">
          <div class="resource-grid">
            <% dashboardData.resourceUsage.forEach(function(resource) { %>
              <div class="resource-item">
                <div class="resource-header">
                  <span class="resource-name"><%= resource.type %></span>
                  <span class="resource-usage"><%= resource.used %> / <%= resource.quota %></span>
                </div>
                <div class="progress-bar">
                  <div class="progress-fill" style="width: <%= resource.percent %>%; background: <%= resource.percent > 90 ? '#ef4444' : resource.percent > 70 ? '#f59e0b' : '#10b981' %>"></div>
                </div>
                <div class="resource-percent"><%= resource.percent %>% used</div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Security summary -->
    <% if (dashboardData?.security) { %>
      <div class="card security-summary-card">
        <div class="card-header">
          <h3 class="card-title">
            <span class="card-icon"><svg width="14" height="14" aria-hidden="true"><use href="#icon-shield"></use></svg></span>
            Security &amp; Monitoring
          </h3>
          <a href="/security" class="btn btn-ghost btn-sm">Review</a>
        </div>
        <div class="card-body security-summary-body">
          <div class="security-score">
            <span class="security-score-value"><%= Number(dashboardData.security.securityScore || 0) %>%</span>
            <span class="security-score-label">Security score</span>
          </div>
          <div class="security-summary-copy">
            <strong><%= Number(dashboardData.security.securityScore || 0) >= 80 ? 'Good standing' : 'Review recommended' %></strong>
            <span><%= Array.isArray(dashboardData.security.recentEvents) ? dashboardData.security.recentEvents.length : 0 %> recent security events</span>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Recent Activity -->
    <% if (dashboardData?.recentActivity && dashboardData.recentActivity.length > 0) { %>
      <div class="card activity-card">
        <div class="card-header">
          <h3 class="card-title">
            <span class="card-icon"><svg width="14" height="14" style="color:#cbd5e1"><use href="#icon-file-text"/></svg></span>
            Recent Activity
          </h3>
        </div>
        <div class="card-body">
          <div class="activity-list">
            <% dashboardData.recentActivity.forEach(function(activity) { %>
              <div class="activity-item">
                <div class="activity-icon" style="background: <%= activity.color %>">
                  <svg width="16" height="16" aria-hidden="true"><use href="#icon-<%= activity.icon || 'activity' %>"></use></svg>
                </div>
                <div class="activity-content">
                  <div class="activity-message"><%= activity.message %></div>
                  <div class="activity-meta">
                    <span class="activity-user"><%= activity.user %></span>
                    <span class="activity-time"><%= activity.time %></span>
                  </div>
                </div>
              </div>
            <% }); %>
          </div>
          <div class="card-footer">
            <a href="/workspaces/<%= activeWorkspace.id %>/activity" class="btn btn-ghost btn-sm">View All Activity</a>
          </div>
        </div>
      </div>
    <% } %>

    <!-- Quick Actions -->
    <% if (dashboardData?.quickActions && dashboardData.quickActions.length > 0) { %>
      <div class="card quick-actions-card">
        <div class="card-header">
          <h3 class="card-title">
            <span class="card-icon"><svg width="14" height="14" style="color:#cbd5e1"><use href="#icon-zap"/></svg></span>
            Quick Actions
          </h3>
        </div>
        <div class="card-body">
          <div class="quick-actions-grid">
            <% dashboardData.quickActions.forEach(function(action) { %>
              <a href="<%= action.href %>" class="quick-action-btn" title="<%= action.tooltip %>">
                <span class="quick-action-icon" style="background: <%= action.color %>"><svg width="16" height="16" aria-hidden="true"><use href="#icon-<%= action.icon || 'plus' %>"></use></svg></span>
                <span class="quick-action-label"><%= action.label %></span>
              </a>
            <% }); %>
          </div>
        </div>
      </div>
    <% } %>
  </main>

  <%- include('../partials/footer') %>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const workspaceSelect = document.getElementById('workspaceSelect');
      if (!workspaceSelect) return;

      workspaceSelect.addEventListener('change', function() {
        if (typeof window.switchWorkspace === 'function') {
          window.switchWorkspace(workspaceSelect.value);
        }
      });
    });
  </script>
</body>
</html>
