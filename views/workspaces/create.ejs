<%- include('../partials/head', { title: (workspace ? 'Edit' : 'Create') + ' Workspace', pageId: 'workspaces' }) %>
<body class="workspace-form-page">
  <%- include('../partials/sidebar') %>
  <%- include('../partials/topbar') %>

  <main class="main-content" id="mainContent">
    <div class="page-header">
      <div class="page-header-left">
        <a href="/workspaces" class="btn btn-ghost">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </a>
        <div>
          <h1 class="page-title"><%= workspace ? 'Edit Workspace' : 'Create Workspace' %></h1>
          <p class="page-subtitle"><%= workspace ? 'Update workspace settings' : 'Create a new workspace for your projects' %></p>
        </div>
      </div>
    </div>

    <div class="form-container">
      <form action="/workspaces<%= workspace ? '/' + workspace.id : '' %>" method="POST" id="workspaceForm" class="card form-card">
        <% if (workspace) { %>
          <input type="hidden" name="_method" value="PUT">
        <% } %>

        <div class="form-section">
          <h3 class="form-section-title">Basic Information</h3>
          <div class="form-grid">
            <div class="form-group">
              <label for="name">Workspace Name *</label>
              <input type="text" id="name" name="name" value="<%= workspace?.name || '' %>" required placeholder="e.g., Acme Corp Production">
              <small class="form-hint">Display name for this workspace</small>
            </div>
            <div class="form-group">
              <label for="slug">Slug *</label>
              <input type="text" id="slug" name="slug" value="<%= workspace?.slug || '' %>" required placeholder="acme-corp-production" pattern="[a-z0-9-]+">
              <small class="form-hint">URL-friendly identifier (lowercase, numbers, hyphens only)</small>
            </div>
            <div class="form-group">
              <label for="type">Workspace Type *</label>
              <select id="type" name="type" required>
                <option value="personal" <%= workspace?.type === 'personal' ? 'selected' : '' %>>👤 Personal</option>
                <option value="clients" <%= workspace?.type === 'clients' ? 'selected' : '' %>>🏢 Clients</option>
                <option value="company" <%= workspace?.type === 'company' ? 'selected' : '' %>>🏭 Company</option>
                <option value="development" <%= workspace?.type === 'development' ? 'selected' : '' %>>💻 Development</option>
                <option value="production" <%= workspace?.type === 'production' ? 'selected' : '' %>>🚀 Production</option>
              </select>
              <small class="form-hint">Type determines default permissions and resource limits</small>
            </div>
            <div class="form-group full-width">
              <label for="description">Description</label>
              <textarea id="description" name="description" rows="3" placeholder="Describe this workspace..."><%= workspace?.description || '' %></textarea>
            </div>
          </div>
        </div>

        <div class="form-section">
          <h3 class="form-section-title">Workspace Type Details</h3>
          <div class="type-info-grid">
            <div class="type-info-card personal">
              <h4>👤 Personal</h4>
              <p>For individual projects and experiments</p>
              <ul>
                <li>Single user focus</li>
                <li>Default resource limits</li>
                <li>Full owner control</li>
              </ul>
            </div>
            <div class="type-info-card clients">
              <h4>🏢 Clients</h4>
              <p>For managing client projects</p>
              <ul>
                <li>Isolated per client</li>
                <li>Separate billing tracking</li>
                <li>Client portal access</li>
              </ul>
            </div>
            <div class="type-info-card company">
              <h4>🏭 Company</h4>
              <p>For internal company operations</p>
              <ul>
                <li>Team collaboration</li>
                <li>Shared resources</li>
                <li>Department-based access</li>
              </ul>
            </div>
            <div class="type-info-card development">
              <h4>💻 Development</h4>
              <p>For development and testing</p>
              <ul>
                <li>Higher resource limits</li>
                <li>Debug tools enabled</li>
                <li>CI/CD integration</li>
              </ul>
            </div>
            <div class="type-info-card production">
              <h4>🚀 Production</h4>
              <p>For live production workloads</p>
              <ul>
                <li>Highest reliability</li>
                <li>Monitoring & alerts</li>
                <li>Backup enforcement</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="form-section">
          <h3 class="form-section-title">Settings</h3>
          <div class="form-grid">
            <div class="form-group checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" name="isDefault" <%= workspace?.is_default ? 'checked' : '' %>>
                <span class="checkmark"></span>
                Set as default workspace
              </label>
              <small class="form-hint">Automatically selected on login</small>
            </div>
            <div class="form-group checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" name="settings.enforceBackups" <%= workspace?.settings?.enforceBackups ? 'checked' : '' %>>
                <span class="checkmark"></span>
                Enforce automatic backups
              </label>
            </div>
            <div class="form-group checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" name="settings.requireApproval" <%= workspace?.settings?.requireApproval ? 'checked' : '' %>>
                <span class="checkmark"></span>
                Require approval for new members
              </label>
            </div>
            <div class="form-group checkbox-group">
              <label class="checkbox-label">
                <input type="checkbox" name="settings.auditLogging" <%= workspace?.settings?.auditLogging ? 'checked' : '' %>>
                <span class="checkmark"></span>
                Enable audit logging
              </label>
            </div>
          </div>
        </div>

        <div class="form-section">
          <h3 class="form-section-title">Resource Limits</h3>
          <div class="form-grid">
            <div class="form-group">
              <label for="resources.maxWebsites">Max Websites</label>
              <input type="number" id="resources.maxWebsites" name="resources[maxWebsites]" value="<%= workspace?.resources?.maxWebsites || 10 %>" min="1">
            </div>
            <div class="form-group">
              <label for="resources.maxApps">Max Applications</label>
              <input type="number" id="resources.maxApps" name="resources[maxApps]" value="<%= workspace?.resources?.maxApps || 20 %>" min="1">
            </div>
            <div class="form-group">
              <label for="resources.maxDatabases">Max Databases</label>
              <input type="number" id="resources.maxDatabases" name="resources[maxDatabases]" value="<%= workspace?.resources?.maxDatabases || 10 %>" min="1">
            </div>
            <div class="form-group">
              <label for="resources.maxStorageGB">Max Storage (GB)</label>
              <input type="number" id="resources.maxStorageGB" name="resources[maxStorageGB]" value="<%= workspace?.resources?.maxStorageGB || 50 %>" min="1">
            </div>
            <div class="form-group">
              <label for="resources.maxBots">Max Bots</label>
              <input type="number" id="resources.maxBots" name="resources[maxBots]" value="<%= workspace?.resources?.maxBots || 5 %>" min="1">
            </div>
            <div class="form-group">
              <label for="resources.maxWorkflows">Max Workflows</label>
              <input type="number" id="resources.maxWorkflows" name="resources[maxWorkflows]" value="<%= workspace?.resources?.maxWorkflows || 20 %>" min="1">
            </div>
            <div class="form-group">
              <label for="resources.maxAiAgents">Max AI Agents</label>
              <input type="number" id="resources.maxAiAgents" name="resources[maxAiAgents]" value="<%= workspace?.resources?.maxAiAgents || 10 %>" min="1">
            </div>
            <div class="form-group">
              <label for="resources.maxEmailAccounts">Max Email Accounts</label>
              <input type="number" id="resources.maxEmailAccounts" name="resources[maxEmailAccounts]" value="<%= workspace?.resources?.maxEmailAccounts || 20 %>" min="1">
            </div>
          </div>
        </div>

        <div class="form-actions">
          <a href="/workspaces" class="btn btn-secondary">Cancel</a>
          <button type="submit" class="btn btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path><polyline points="17 21 17 13 7 13 7 21"></polyline><polyline points="7 3 7 8 15 8"></polyline></svg>
            <%= workspace ? 'Update Workspace' : 'Create Workspace' %>
          </button>
        </div>
      </form>
    </div>
  </main>

  <%- include('../partials/footer') %>
  <script>
    // Auto-generate slug from name
    document.getElementById('name').addEventListener('input', function() {
      const slugInput = document.getElementById('slug');
      if (!slugInput.dataset.manuallyEdited) {
        slugInput.value = this.value
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
      }
    });

    document.getElementById('slug').addEventListener('input', function() {
      this.dataset.manuallyEdited = 'true';
    });

    // Highlight selected type
    const typeSelect = document.getElementById('type');
    typeSelect.addEventListener('change', function() {
      document.querySelectorAll('.type-info-card').forEach(card => {
        card.classList.remove('selected');
      });
      const selectedCard = document.querySelector('.type-info-card.' + this.value);
      if (selectedCard) {
        selectedCard.classList.add('selected');
      }
    });

    // Trigger initial highlight
    typeSelect.dispatchEvent(new Event('change'));
  </script>
  <style>
    .form-container { max-width: 900px; margin: 0 auto; padding: 1.5rem; }
    .form-card { background: var(--card-bg); border-radius: 12px; }
    .form-section { padding: 1.5rem; border-bottom: 1px solid var(--border-color); }
    .form-section:last-child { border-bottom: none; }
    .form-section-title { margin: 0 0 1rem; font-size: 1rem; color: var(--text-primary); }
    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
    .form-group { display: flex; flex-direction: column; gap: 0.35rem; }
    .form-group.full-width { grid-column: 1 / -1; }
    .form-group label { font-size: 0.875rem; font-weight: 500; color: var(--text-primary); }
    .form-group input, .form-group select, .form-group textarea {
      padding: 0.625rem 0.875rem;
      border: 1px solid var(--border-color);
      border-radius: 8px;
      background: var(--input-bg);
      color: var(--text-primary);
      font-size: 0.9375rem;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-alpha);
    }
    .form-hint { font-size: 0.75rem; color: var(--text-muted); }
    .checkbox-group { display: flex; align-items: flex-start; gap: 0.5rem; }
    .checkbox-label { display: flex; align-items: center; gap: 0.5rem; cursor: pointer; font-weight: 400; }
    .checkbox-label input { width: 18px; height: 18px; accent-color: var(--primary); }
    .type-info-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 1rem; }
    .type-info-card { padding: 1rem; border: 1px solid var(--border-color); border-radius: 8px; background: var(--bg-secondary); transition: all 0.2s; }
    .type-info-card:hover, .type-info-card.selected { border-color: var(--primary); background: var(--primary-alpha); }
    .type-info-card h4 { margin: 0 0 0.5rem; font-size: 0.875rem; }
    .type-info-card p { margin: 0 0 0.5rem; font-size: 0.8125rem; color: var(--text-secondary); }
    .type-info-card ul { margin: 0; padding-left: 1.25rem; font-size: 0.75rem; color: var(--text-muted); }
    .type-info-card li { margin: 0.25rem 0; }
    .form-actions { display: flex; justify-content: flex-end; gap: 0.75rem; padding: 1.5rem; border-top: 1px solid var(--border-color); }
  </style>
</body>
</html>