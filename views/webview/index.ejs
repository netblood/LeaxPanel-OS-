<% 
  const primaryColor = (typeof panelSettings !== 'undefined' && panelSettings && panelSettings.primary_color) ? panelSettings.primary_color : '#7c5cff';
%>
<style>
  :root {
    --primary: <%= primaryColor %>;
  }
  .webview-wrapper {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 200px);
    background: #0a0b14;
  }
  .webview-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.5rem;
    background: rgba(255,255,255,0.03);
    border-bottom: 1px solid rgba(255,255,255,0.08);
    z-index: 10;
  }
  .webview-url-input {
    flex: 1;
    max-width: 600px;
    padding: 0.5rem 1rem;
    border-radius: 6px;
    border: 1px solid rgba(255,255,255,0.12);
    background: #1a1b26;
    color: #e2e8f0;
    font-size: 0.95rem;
  }
  .webview-url-input:focus {
    outline: none;
    border-color: var(--primary);
  }
  .webview-frame-wrap {
    flex: 1;
    position: relative;
    overflow: hidden;
  }
  .webview-frame-wrap iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: #0a0b14;
  }
  .webview-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: #94a3b8;
    text-align: center;
  }
  .webview-empty svg {
    width: 64px;
    height: 64px;
    margin-bottom: 1rem;
    opacity: 0.4;
  }
</style>

<div class="page-header">
  <div>
    <h1 class="page-title">Webview / Site Preview</h1>
    <p class="page-subtitle">Preview your deployed websites and applications from within LeaxPanel.</p>
  </div>
  <div class="page-actions">
    <a href="/website" class="btn btn-ghost">Back to Websites</a>
  </div>
</div>

<div class="card webview-wrapper">
  <div class="webview-toolbar">
    <div class="webview-url-group">
      <label class="webview-url-label" style="color:#94a3b8;font-size:0.85rem;margin-right:0.5rem;">Site URL</label>
      <input type="url" id="webviewUrl" class="webview-url-input" placeholder="https://example.com or http://localhost:8080" value="<%= targetUrl %>">
    </div>
    <button id="webviewLoadBtn" class="btn btn-primary" style="margin-left:0.5rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5l3 3L3 3"></path></svg>
      Load
    </button>
    <button id="webviewRefreshBtn" class="btn btn-secondary" style="margin-left:0.5rem;">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M1 4v16l3.8-2"></path><path d="M23 20v-16L19.2 4"></path><circle cx="12" cy="12" r="3"></circle></svg>
      Refresh
    </button>
  </div>
  <div class="webview-frame-wrap">
    <% if (!targetUrl) { %>
      <div class="webview-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><polyline points="16 16 21 21 16 26"></polyline></svg>
        <p>Enter a URL above to preview your site</p>
      </div>
    <% } else { %>
      <iframe id="webviewIframe" src="<%= targetUrl %>" referrerpolicy="no-referrer" sandbox="allow-same-origin allow-scripts allow-popups allow-forms"></iframe>
    <% } %>
  </div>
</div>

<script>
  (function() {
    const urlInput = document.getElementById('webviewUrl');
    const loadBtn = document.getElementById('webviewLoadBtn');
    const refreshBtn = document.getElementById('webviewRefreshBtn');
    const iframe = document.getElementById('webviewIframe');
    const emptyState = document.querySelector('.webview-empty');

    function loadUrl() {
      const url = urlInput.value.trim();
      if (!url) {
        if (emptyState) emptyState.hidden = false;
        if (iframe) iframe.hidden = true;
        return;
      }

      // Ensure scheme
      let target = url;
      if (!/^https?:\/\//i.test(target)) {
        target = 'https://' + target;
        urlInput.value = target;
      }

      if (iframe) {
        iframe.src = target;
        iframe.hidden = false;
      }
      if (emptyState) emptyState.hidden = true;
    }

    loadBtn.addEventListener('click', loadUrl);

    urlInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        e.preventDefault();
        loadUrl();
      }
    });

    refreshBtn.addEventListener('click', function() {
      if (iframe && iframe.src) {
        iframe.src = iframe.src;
      }
    });
  })();
</script>
