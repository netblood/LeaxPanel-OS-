<%- include('../partials/head'); %>
<title>Monitoring - LEAXOS</title>
<body>
  <%- include('../partials/navbar'); %>
  <main class="container">
    <%- include('../partials/flash'); %>
    <h1>Monitoring</h1>
    <div class="stats-grid">
      <div class="stat-card">
        <h3>CPU Cores</h3>
        <p><%= stats.cpu %></p>
      </div>
      <div class="stat-card">
        <h3>Memory</h3>
        <p><%= stats.freemem %> / <%= stats.totalmem %></p>
      </div>
      <div class="stat-card">
        <h3>Uptime</h3>
        <p><%= stats.uptime %></p>
      </div>
      <div class="stat-card">
        <h3>Platform</h3>
        <p><%= stats.platform %> <%= stats.arch %></p>
      </div>
    </div>
  </main>
  <script src="/js/main.js"></script>
</body>
