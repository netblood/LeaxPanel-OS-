<div class="page-header">
  <div>
    <h1 class="page-title">Monitoring</h1>
    <p class="page-subtitle">Realtime CPU, memory, disk, network and telemetry</p>
  </div>
  <div class="page-actions">
    <a href="/monitoring/metrics.json" class="btn btn-secondary">Metrics JSON</a>
    <a href="/doctor" class="btn btn-secondary">Health check</a>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-card">
    <div class="stat-top">
      <span class="stat-label">CPU</span>
      <span class="stat-icon">◴</span>
    </div>
    <div class="stat-value"><%= cpu.usage %>%</div>
    <div class="stat-delta flat"><%= cpu.cores %> cores · load <%= Number(cpu.load || 0).toFixed(2) %></div>
    <div class="stat-meter"><span style="width:<%= Math.min(100, cpu.usage) %>%"></span></div>
  </div>
  <div class="stat-card">
    <div class="stat-top">
      <span class="stat-label">Memory</span>
      <span class="stat-icon">◑</span>
    </div>
    <div class="stat-value"><%= memory.usage %>%</div>
    <div class="stat-delta flat"><%= memory.usedLabel %> of <%= memory.totalLabel %></div>
    <div class="stat-meter"><span style="width:<%= Math.min(100, memory.usage) %>%"></span></div>
  </div>
  <div class="stat-card">
    <div class="stat-top">
      <span class="stat-label">Disk</span>
      <span class="stat-icon">◱</span>
    </div>
    <div class="stat-value"><%= disk.usage %>%</div>
    <div class="stat-delta flat"><%= disk.usedLabel %> of <%= disk.totalLabel %></div>
    <div class="stat-meter"><span style="width:<%= Math.min(100, disk.usage) %>%"></span></div>
  </div>
  <div class="stat-card">
    <div class="stat-top">
      <span class="stat-label">Uptime</span>
      <span class="stat-icon success">◷</span>
    </div>
    <div class="stat-value sm"><%= uptimeLabel %></div>
    <div class="stat-delta flat"><%= hostname %> · <%= platform %>/<%= arch %></div>
  </div>
</div>

<div class="grid-2" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:var(--sp-4);margin-bottom:var(--sp-4);">
  <div class="card">
    <div class="card-header">
      <div>
        <h3>Resource usage</h3>
        <p>Live utilisation per resource</p>
      </div>
    </div>
    <div class="card-body">
      <% resources.forEach(function(r) { %>
        <div style="margin-bottom:var(--sp-4);">
          <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
            <span class="form-label" style="margin:0;"><%= r.label %></span>
            <span class="text-sm text-muted"><%= r.usage %>%</span>
          </div>
          <div class="stat-meter <%= r.usage >= 90 ? 'danger' : r.usage >= 75 ? 'warning' : '' %>">
            <span style="width:<%= Math.min(100, r.usage) %>%"></span>
          </div>
          <span class="form-hint"><%= r.detail %></span>
        </div>
      <% }); %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <div>
        <h3>Network interfaces</h3>
        <p>Active IPv4 addresses</p>
      </div>
    </div>
    <div class="card-body">
      <% if (!network || !network.length) { %>
        <div class="empty-state" style="padding:var(--sp-8) var(--sp-4);">
          <div class="empty-icon">⇅</div>
          <h3>No external interfaces</h3>
          <p>Only loopback interfaces are available.</p>
        </div>
      <% } else { %>
        <div class="activity-list">
          <% network.forEach(function(n) { %>
            <div class="activity-item">
              <span class="activity-icon">⇅</span>
              <div class="activity-body">
                <div class="activity-title"><%= n.interface %></div>
                <div class="activity-meta text-mono"><%= n.address %> · <%= n.mac %></div>
              </div>
            </div>
          <% }); %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <h3>Recorded metrics</h3>
      <p>Historical samples from the monitoring service</p>
    </div>
  </div>
  <div class="card-body">
    <% if (!metrics || !metrics.length) { %>
      <div class="empty-state" style="padding:var(--sp-8) var(--sp-4);">
        <div class="empty-icon">◴</div>
        <h3>No metrics recorded yet</h3>
        <p>The monitoring service samples the system every few minutes.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Metric</th>
              <th>Value</th>
              <th>Labels</th>
              <th>Recorded</th>
            </tr>
          </thead>
          <tbody>
            <% metrics.forEach(function(m) { %>
              <tr>
                <td class="cell-primary"><%= m.metric_name %></td>
                <td><%= m.metric_value %></td>
                <td class="text-muted text-xs"><%= m.labels || '—' %></td>
                <td><%= m.recorded_at %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
