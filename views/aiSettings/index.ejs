<div class="page-header">
  <div>
    <h1 class="page-title">AI Providers</h1>
    <p class="page-subtitle">Per-user AI configuration, models and knowledge bases</p>
  </div>
  <div class="page-actions">
    <a href="/ai" class="btn btn-secondary">AI agents</a>
  </div>
</div>

<div class="card" style="margin-bottom:var(--sp-4);">
  <div class="card-header">
    <div>
      <h3>Connect a provider</h3>
      <p>OpenAI, Claude, Gemini, OpenRouter, DeepSeek, Mistral, Grok, Ollama or any OpenAI-compatible API</p>
    </div>
  </div>
  <div class="card-body">
    <form action="/ai-settings/create" method="POST" class="form-grid" data-loading>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label class="form-label" for="provider">Provider<span class="req">*</span></label>
        <select class="form-control" id="provider" name="provider" required>
          <% providers.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.label %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="name">Configuration name</label>
        <input class="form-control" type="text" id="name" name="name" placeholder="My OpenAI account">
      </div>
      <div class="form-group">
        <label class="form-label" for="base_url">Base URL</label>
        <input class="form-control" type="text" id="base_url" name="base_url" placeholder="https://api.openai.com/v1">
        <span class="form-hint">Leave blank to use the provider default.</span>
      </div>
      <div class="form-group">
        <label class="form-label" for="api_key">API key</label>
        <input class="form-control" type="password" id="api_key" name="api_key" placeholder="sk-..." autocomplete="off">
        <span class="form-hint">Stored encrypted with AES-256-GCM.</span>
      </div>
      <div class="form-group">
        <label class="form-label" for="model">Model</label>
        <input class="form-control" type="text" id="model" name="model" placeholder="gpt-4o-mini">
      </div>
      <div class="form-group">
        <label class="form-label" for="temperature">Temperature</label>
        <input class="form-control" type="number" id="temperature" name="temperature" value="0.7" step="0.1" min="0" max="2">
      </div>
      <div class="form-group">
        <label class="form-label" for="max_tokens">Max tokens</label>
        <input class="form-control" type="number" id="max_tokens" name="max_tokens" value="2048" min="1">
      </div>
      <div class="form-group span-2">
        <label class="form-label" for="system_prompt">System prompt</label>
        <textarea class="form-control" id="system_prompt" name="system_prompt" placeholder="You are a helpful assistant..."></textarea>
      </div>
      <div class="form-group span-2">
        <label class="form-check">
          <input type="checkbox" id="is_default" name="is_default">
          <span>Use as the default provider for this account</span>
        </label>
      </div>
      <div class="form-group span-2 form-actions">
        <button type="submit" class="btn btn-primary">Save provider</button>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <div>
      <h3>Your providers</h3>
      <p><%= (settings || []).length %> configuration(s)</p>
    </div>
  </div>
  <div class="card-body">
    <% if (!settings || !settings.length) { %>
      <div class="empty-state">
        <div class="empty-icon">◈</div>
        <h3>No providers connected</h3>
        <p>Add your first AI provider above to unlock the AI agents platform.</p>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Name</th>
              <th>Provider</th>
              <th>Model</th>
              <th>Key</th>
              <th>Base URL</th>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% settings.forEach(function(s) { %>
              <tr>
                <td class="cell-primary">
                  <%= s.name %>
                  <% if (s.is_default) { %><span class="badge badge-primary">Default</span><% } %>
                </td>
                <td><span class="badge badge-info badge-plain"><%= s.provider %></span></td>
                <td><%= s.model || '—' %></td>
                <td class="text-mono text-xs"><%= s.hasKey ? s.keyMasked : '—' %></td>
                <td class="text-muted text-sm"><%= s.base_url || 'default' %></td>
                <td class="col-actions">
                  <div class="btn-group">
                    <a href="/ai-settings/<%= s.id %>/edit" class="btn btn-secondary btn-sm">Edit</a>
                    <form action="/ai-settings/<%= s.id %>/delete" method="POST" data-confirm="Delete this provider configuration?">
                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                      <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<div class="card" style="margin-top:var(--sp-4);">
  <div class="card-header">
    <div>
      <h3>Knowledge bases</h3>
      <p>Documents your agents can reference</p>
    </div>
  </div>
  <div class="card-body">
    <% if (!knowledgeBases || !knowledgeBases.length) { %>
      <div class="empty-state" style="padding:var(--sp-8) var(--sp-4);">
        <div class="empty-icon">◫</div>
        <h3>No knowledge bases</h3>
        <p>Create agents and attach documents to give them domain knowledge.</p>
      </div>
    <% } else { %>
      <div class="activity-list">
        <% knowledgeBases.forEach(function(kb) { %>
          <div class="activity-item">
            <span class="activity-icon">◫</span>
            <div class="activity-body">
              <div class="activity-title"><%= kb.name %></div>
              <div class="activity-meta"><%= kb.chunk_count || 0 %> chunks · <%= kb.embedding_model || 'no embedding' %></div>
            </div>
            <span class="badge badge-<%= kb.status === 'ready' ? 'success' : 'muted' %>"><%= kb.status %></span>
          </div>
        <% }); %>
      </div>
    <% } %>
  </div>
</div>
