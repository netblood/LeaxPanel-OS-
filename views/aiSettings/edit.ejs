<div class="page-header">
  <div>
    <h1 class="page-title">Edit AI provider</h1>
    <p class="page-subtitle">Update the provider configuration</p>
  </div>
  <div class="page-actions">
    <a href="/ai-settings" class="btn btn-ghost">Back to providers</a>
  </div>
</div>

<form action="/ai-settings/<%= values.id %>/edit" method="POST" class="card" data-loading>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label" for="provider">Provider<span class="req">*</span></label>
        <select class="form-control" id="provider" name="provider" required>
          <% providers.forEach(function(p) { %>
            <option value="<%= p.id %>" <%= values.provider === p.id ? 'selected' : '' %>><%= p.label %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label class="form-label" for="name">Configuration name</label>
        <input class="form-control" type="text" id="name" name="name" value="<%= values.name || '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="base_url">Base URL</label>
        <input class="form-control" type="text" id="base_url" name="base_url" value="<%= values.base_url || '' %>" placeholder="https://api.openai.com/v1">
      </div>
      <div class="form-group">
        <label class="form-label" for="api_key">API key</label>
        <input class="form-control" type="password" id="api_key" name="api_key" placeholder="<%= values.hasKey ? values.keyMasked : 'sk-...' %>" autocomplete="off">
        <span class="form-hint">Leave blank to keep the current key.</span>
      </div>
      <div class="form-group">
        <label class="form-label" for="model">Model</label>
        <input class="form-control" type="text" id="model" name="model" value="<%= values.model || '' %>">
      </div>
      <div class="form-group">
        <label class="form-label" for="temperature">Temperature</label>
        <input class="form-control" type="number" id="temperature" name="temperature" value="<%= values.temperature !== null && values.temperature !== undefined ? values.temperature : 0.7 %>" step="0.1" min="0" max="2">
      </div>
      <div class="form-group">
        <label class="form-label" for="max_tokens">Max tokens</label>
        <input class="form-control" type="number" id="max_tokens" name="max_tokens" value="<%= values.max_tokens || 2048 %>" min="1">
      </div>
      <div class="form-group span-2">
        <label class="form-label" for="system_prompt">System prompt</label>
        <textarea class="form-control" id="system_prompt" name="system_prompt"><%= values.system_prompt || '' %></textarea>
      </div>
      <div class="form-group span-2">
        <label class="form-check">
          <input type="checkbox" id="is_default" name="is_default" <%= values.is_default ? 'checked' : '' %>>
          <span>Use as the default provider for this account</span>
        </label>
      </div>
    </div>
  </div>
  <div class="card-footer form-actions">
    <button type="submit" class="btn btn-primary">Save changes</button>
    <a href="/ai-settings" class="btn btn-ghost">Cancel</a>
  </div>
</form>
