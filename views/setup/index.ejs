<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%- include('../partials/head'); %>
  <title>Setup wizard · LeaxPanel</title>
</head>
<body class="app-body">
  <div class="app-content app-content-public">
    <div style="max-width:900px;margin:0 auto;padding:var(--sp-8) var(--sp-5);">
      <div class="page-header">
        <div style="display:flex;align-items:center;gap:var(--sp-3);margin-bottom:var(--sp-4);">
          <img src="/images/logo.png" alt="LeaxPanel" class="setup-logo" width="32" height="32">
          <div>
            <h1 class="page-title">Setup wizard</h1>
            <p class="page-subtitle">One click and LeaxPanel is ready to host anything</p>
          </div>
        </div>
      </div>

      <% if (typeof success !== 'undefined' && success && success.length) { %>
        <% success.forEach(function(msg) { %>
          <div class="alert alert-success"><span class="alert-icon"><svg width="16" height="16" style="color:#22c55e"><use href="#icon-check-circle"/></svg></span><div><%= msg %></div></div>
        <% }); %>
      <% } %>
      <% if (typeof error !== 'undefined' && error && error.length) { %>
        <% error.forEach(function(msg) { %>
          <div class="alert alert-danger"><span class="alert-icon">!</span><div><%= msg %></div></div>
        <% }); %>
      <% } %>

      <!-- Steps -->
      <div class="card" style="margin-bottom:var(--sp-4);">
        <div class="card-body">
          <div style="display:flex;gap:var(--sp-2);flex-wrap:wrap;">
            <% steps.forEach(function(step, i) { %>
              <div style="flex:1;min-width:120px;text-align:center;">
                <div class="stat-icon" style="margin:0 auto var(--sp-2);"><%= i + 1 %></div>
                <div class="text-xs text-muted"><%= step.label %></div>
              </div>
            <% }); %>
          </div>
        </div>
      </div>

      <!-- 1. Environment -->
      <div class="card" style="margin-bottom:var(--sp-4);">
        <div class="card-header">
          <div>
            <h3>1 · Environment detection</h3>
            <p>LeaxPanel inspects your machine automatically</p>
          </div>
          <form action="/setup/detect" method="POST">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-secondary btn-sm">Re-detect</button>
          </form>
        </div>
        <div class="card-body">
          <div class="table-wrap">
            <table class="data-table">
              <tbody>
                <tr><td class="cell-primary">Operating system</td><td><%= env.os %></td></tr>
                <tr><td class="cell-primary">Architecture</td><td><%= env.arch %></td></tr>
                <tr><td class="cell-primary">Node.js</td><td><%= env.nodeVersion %> <span class="badge badge-success">supported</span></td></tr>
                <tr><td class="cell-primary">Hostname</td><td><%= env.hostname %></td></tr>
                <tr><td class="cell-primary">Uptime</td><td><%= env.uptime %></td></tr>
                <tr><td class="cell-primary">PM2</td><td><span class="badge badge-<%= env.pm2 ? 'success' : 'muted' %>"><%= env.pm2 ? 'installed' : 'not found' %></span></td></tr>
                <tr><td class="cell-primary">Nginx</td><td><span class="badge badge-<%= env.nginx ? 'success' : 'muted' %>"><%= env.nginx ? 'installed' : 'not found' %></span></td></tr>
                <tr><td class="cell-primary">Docker</td><td><span class="badge badge-<%= env.docker ? 'success' : 'muted' %>"><%= env.docker ? 'installed' : 'not found' %></span></td></tr>
                <tr><td class="cell-primary">Certbot</td><td><span class="badge badge-<%= env.certbot ? 'success' : 'muted' %>"><%= env.certbot ? 'installed' : 'not found' %></span></td></tr>
                <tr><td class="cell-primary">Firewall</td><td><%= env.firewall %></td></tr>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- 2. Administrator -->
      <div class="card" style="margin-bottom:var(--sp-4);">
        <div class="card-header">
          <div>
            <h3>2 · Administrator account</h3>
            <p><%= hasOwner ? 'An owner account already exists.' : 'Create the owner account that will manage this panel.' %></p>
          </div>
        </div>
        <% if (!hasOwner) { %>
        <div class="card-body">
          <form action="/setup/account" method="POST" class="form-grid" data-loading>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label class="form-label" for="name">Full name<span class="req">*</span></label>
              <input class="form-control" type="text" id="name" name="name" placeholder="Bilal Chentouf" required>
            </div>
            <div class="form-group">
              <label class="form-label" for="email">Email address<span class="req">*</span></label>
              <input class="form-control" type="email" id="email" name="email" placeholder="owner@example.com" required>
            </div>
            <div class="form-group span-2">
              <label class="form-label" for="password">Password<span class="req">*</span></label>
              <input class="form-control" type="password" id="password" name="password" required minlength="8">
              <span class="form-hint">At least 8 characters. This account has full control of the panel.</span>
            </div>
            <div class="form-group span-2 form-actions">
              <button type="submit" class="btn btn-primary">Create administrator</button>
            </div>
          </form>
        </div>
        <% } %>
      </div>

      <!-- 3. Branding -->
      <div class="card" style="margin-bottom:var(--sp-4);">
        <div class="card-header">
          <div>
            <h3>3 · Branding</h3>
            <p>Make the panel yours</p>
          </div>
        </div>
        <div class="card-body">
          <form action="/setup/branding" method="POST" class="form-grid" data-loading>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="form-group">
              <label class="form-label" for="panel_name">Panel name</label>
              <input class="form-control" type="text" id="panel_name" name="panel_name" value="<%= panelSettings.panel_name || 'LeaxPanel' %>">
            </div>
            <div class="form-group">
              <label class="form-label" for="panel_tagline">Tagline</label>
              <input class="form-control" type="text" id="panel_tagline" name="panel_tagline" value="<%= panelSettings.panel_tagline || '' %>">
            </div>
            <div class="form-group">
              <label class="form-label" for="primary_color">Primary colour</label>
              <input class="form-control" type="color" id="primary_color" name="primary_color" value="<%= panelSettings.primary_color || '#7c5cff' %>" style="height:44px;padding:4px;">
            </div>
            <div class="form-group">
              <label class="form-label" for="accent_color">Accent colour</label>
              <input class="form-control" type="color" id="accent_color" name="accent_color" value="<%= panelSettings.accent_color || '#22d3ee' %>" style="height:44px;padding:4px;">
            </div>
            <div class="form-group span-2">
              <label class="form-label" for="support_email">Support email</label>
              <input class="form-control" type="email" id="support_email" name="support_email" value="<%= panelSettings.support_email || '' %>">
            </div>
            <div class="form-group span-2 form-actions">
              <button type="submit" class="btn btn-primary">Save branding</button>
            </div>
          </form>
        </div>
      </div>

            <!-- 4. Domain Setup -->
      <div class="card" style="margin-bottom:var(--sp-4);">
        <div class="card-header">
          <div>
                  <h3>4 · Domain Setup</h3>
                  <p>Configure Cloudflare and platform domain for automatic subdomains, DNS, and SSL</p>
          </div>
        </div>
        <div class="card-body">
                <form action="/setup/domain" method="POST" class="form-grid" data-loading>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
                  <div class="card" style="margin-bottom:var(--sp-4);">
                    <div class="card-header">
                      <h4>Cloudflare Configuration</h4>
                      <p class="text-sm text-muted">Optional: Connect Cloudflare for automatic DNS provisioning and SSL</p>
                    </div>
                    <div class="card-body">
                      <div class="form-group span-2">
                        <label class="form-label" for="cloudflare_api_token">Cloudflare API Token <span class="req">*</span></label>
                        <input class="form-control" type="password" id="cloudflare_api_token" name="cloudflare_api_token" placeholder="Enter your Cloudflare API Token" <%= cloudflareConfigured ? 'readonly' : '' %>>
                        <span class="form-hint">Create a token with Zone:DNS:Edit permissions at <a href="https://dash.cloudflare.com/profile/api-tokens" target="_blank">dash.cloudflare.com/profile/api-tokens</a></span>
                      </div>
                      <div class="form-group span-2">
                        <label class="form-label" for="cloudflare_zone_id">Cloudflare Zone ID <span class="req">*</span></label>
                        <input class="form-control" type="text" id="cloudflare_zone_id" name="cloudflare_zone_id" placeholder="Zone ID from Cloudflare dashboard" <%= cloudflareConfigured ? 'readonly' : '' %>>
                        <span class="form-hint">Find Zone ID on your domain overview page in Cloudflare</span>
                      </div>
                      <% if (cloudflareConfigured) { %>
                      <div class="form-group span-2">
                        <label class="form-label">Connected Zone</label>
                        <div class="form-control-plaintext">
                          <span class="badge badge-success"><%= panelSettings.cloudflare_zone_name || 'Unknown' %></span>
                          <span class="ms-2"><%= cloudflareValidated ? '<svg width="16" height="16" style="color:#22c55e;vertical-align:middle"><use href="#icon-check-circle"/></svg> Validated' : '<svg width="16" height="16" style="color:#ef4444;vertical-align:middle"><use href="#icon-x-circle"/></svg> Validation failed</span>' %></span>
                        </div>
                      </div>
                      <% } %>
                    </div>
                  </div>

                  <div class="card" style="margin-bottom:var(--sp-4);">
                    <div class="card-header">
                      <h4>Platform Domain</h4>
                      <p class="text-sm text-muted">All services will receive subdomains under this domain</p>
                    </div>
                    <div class="card-body">
                      <div class="form-group span-2">
                        <label class="form-label" for="platform_domain">Platform Domain <span class="req">*</span></label>
                        <input class="form-control" type="text" id="platform_domain" name="platform_domain" placeholder="apps.example.com" value="<%= platformDomain || '' %>" required>
                        <span class="form-hint">Example: apps.netblood.ma — Services get subdomains like shop.apps.netblood.ma, api.apps.netblood.ma</span>
                      </div>
                      <% if (platformDomainConfigured) { %>
                      <div class="form-group span-2">
                        <div class="form-control-plaintext">
                          <span class="badge badge-success">Configured: <%= platformDomain %></span>
                        </div>
                      </div>
                      <% } %>
                    </div>
                  </div>

                  <div class="card">
                    <div class="card-header">
                      <h4>Auto Features</h4>
                      <p class="text-sm text-muted">Enable automatic provisioning features (requires Cloudflare)</p>
                    </div>
                    <div class="card-body">
                      <div class="form-group">
                        <label class="form-check">
                          <input type="checkbox" id="auto_ssl" name="auto_ssl" <%= panelSettings.auto_ssl === 'true' ? 'checked' : '' %> <%= !cloudflareConfigured ? 'disabled' : '' %>>
                          <span><strong>Auto SSL</strong><span class="form-hint">Automatically provision SSL certificates for all services</span></span>
                        </label>
                      </div>
                      <div class="form-group">
                        <label class="form-check">
                          <input type="checkbox" id="auto_dns" name="auto_dns" <%= panelSettings.auto_dns === 'true' ? 'checked' : '' %> <%= !cloudflareConfigured ? 'disabled' : '' %>>
                          <span><strong>Auto DNS</strong><span class="form-hint">Automatically create DNS records for service subdomains</span></span>
                        </label>
                      </div>
                      <div class="form-group">
                        <label class="form-check">
                          <input type="checkbox" id="auto_subdomains" name="auto_subdomains" <%= panelSettings.auto_subdomains === 'true' ? 'checked' : '' %> <%= !cloudflareConfigured ? 'disabled' : '' %>>
                          <span><strong>Auto Subdomains</strong><span class="form-hint">Automatically generate subdomains for new services</span></span>
                        </label>
                      </div>
                      <div class="form-group">
                        <label class="form-check">
                          <input type="checkbox" id="auto_backups" name="auto_backups" <%= panelSettings.auto_backups === 'true' ? 'checked' : '' %>>
                          <span><strong>Auto Backups</strong><span class="form-hint">Automatically backup services on schedule</span></span>
                        </label>
                      </div>
                      <div class="form-group">
                        <label class="form-check">
                          <input type="checkbox" id="auto_monitoring" name="auto_monitoring" <%= panelSettings.auto_monitoring === 'true' ? 'checked' : '' %>>
                          <span><strong>Auto Monitoring</strong><span class="form-hint">Automatically monitor service health</span></span>
                        </label>
                      </div>
                    </div>
                  </div>

                  <div class="form-group span-2 form-actions">
                    <button type="submit" class="btn btn-primary">Save domain settings</button>
                  </div>
                </form>
              </div>
            </div>

            <!-- 5. Security Setup -->
            <div class="card" style="margin-bottom:var(--sp-4);">
              <div class="card-header">
                <div>
                  <h3>5 · Security Setup</h3>
                  <p>Configure authentication, sessions, and password policies</p>
                </div>
              </div>
              <div class="card-body">
                <form action="/setup/security" method="POST" class="form-grid" data-loading>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            
                  <div class="card" style="margin-bottom:var(--sp-4);">
                    <div class="card-header">
                      <h4>Two-Factor Authentication</h4>
                    </div>
                    <div class="card-body">
                      <div class="form-group span-2">
                        <label class="form-check">
                          <input type="checkbox" id="two_factor_enabled" name="two_factor_enabled" <%= panelSettings.two_factor_enabled === 'true' ? 'checked' : '' %>>
                          <span><strong>Enable 2FA for all users</strong><span class="form-hint">Require TOTP authentication on login</span></span>
                        </label>
                      </div>
                    </div>
                  </div>

                  <div class="card" style="margin-bottom:var(--sp-4);">
                    <div class="card-header">
                      <h4>Session Settings</h4>
                    </div>
                    <div class="card-body">
                      <div class="form-group">
                        <label class="form-label" for="session_timeout">Session timeout (ms)</label>
                        <input class="form-control" type="number" id="session_timeout" name="session_timeout" value="<%= panelSettings.session_timeout || '86400000' %>">
                      </div>
                      <div class="form-group">
                        <label class="form-label" for="max_sessions">Max concurrent sessions</label>
                        <input class="form-control" type="number" id="max_sessions" name="max_sessions" value="<%= panelSettings.max_sessions || '5' %>">
                      </div>
                    </div>
                  </div>

                  <div class="card">
                    <div class="card-header">
                      <h4>Password Policy</h4>
                    </div>
                    <div class="card-body">
                      <div class="form-group">
                        <label class="form-label" for="password_min_length">Minimum length</label>
                        <input class="form-control" type="number" id="password_min_length" name="password_min_length" value="<%= panelSettings.password_min_length || '8' %>" min="8" max="128">
                      </div>
                      <div class="form-group">
                        <label class="form-check">
                          <input type="checkbox" id="password_require_upper" name="password_require_upper" <%= panelSettings.password_require_upper === 'true' ? 'checked' : '' %>>
                          <span>Require uppercase letters</span>
                        </label>
                      </div>
                      <div class="form-group">
                        <label class="form-check">
                          <input type="checkbox" id="password_require_numbers" name="password_require_numbers" <%= panelSettings.password_require_numbers === 'true' ? 'checked' : '' %>>
                          <span>Require numbers</span>
                        </label>
                      </div>
                      <div class="form-group">
                        <label class="form-check">
                          <input type="checkbox" id="password_require_symbols" name="password_require_symbols" <%= panelSettings.password_require_symbols === 'true' ? 'checked' : '' %>>
                          <span>Require symbols</span>
                        </label>
                      </div>
                    </div>
                  </div>

                  <div class="form-group span-2 form-actions">
                    <button type="submit" class="btn btn-primary">Save security settings</button>
                  </div>
                </form>
              </div>
            </div>

            <!-- 6. Services -->
            <div class="card" style="margin-bottom:var(--sp-4);">
              <div class="card-header">
                <div>
                  <h3>6 · Services</h3>
                  <p>Choose which features are active</p>
                </div>
              </div>
              <div class="card-body">
                <form action="/setup/services" method="POST" data-loading>
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <div class="form-group">
                    <label class="form-check">
                      <input type="checkbox" id="registration_enabled" name="registration_enabled" <%= panelSettings.registration_enabled === 'true' ? 'checked' : '' %>>
                      <span><strong>Allow public registration</strong><span class="form-hint">Visitors can create accounts themselves.</span></span>
                    </label>
                  </div>
                  <button type="submit" class="btn btn-primary">Save preferences</button>
                </form>
              </div>
            </div>

            <!-- 7. Finish -->
            <div class="card">
              <div class="card-header">
                <div>
                  <h3>7 · Finish</h3>
                  <p>Everything is ready</p>
                </div>
              </div>
              <div class="card-body">
                <% if (setupComplete) { %>
                  <div class="alert alert-success"><span class="alert-icon"><svg width="16" height="16" style="color:#22c55e"><use href="#icon-check-circle"/></svg></span><div>Setup is already complete.</div></div>
                <% } %>
                <form action="/setup/finish" method="POST" data-confirm="Finalise setup and mark it as complete?">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="btn btn-primary btn-lg">Complete setup</button>
                  <a href="/login" class="btn btn-ghost btn-lg">Skip and go to login</a>
                </form>
              </div>
            </div>
    </div>
  </div>
  <script src="/js/main.js"></script>
</body>
</html>
