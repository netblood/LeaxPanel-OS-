<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <%- include('partials/head'); %>
  <title><%= typeof title !== 'undefined' && title ? title : 'LeaxPanel - Host Anything. Manage Everything. Deploy Anywhere.' %></title>
</head>
<body class="home-page">
  <header class="topbar" style="position:sticky;top:0;z-index:50;">
    <div class="topbar-left">
      <a href="/" class="brand-link">
        <span class="brand-mark">⚡</span>
        <span class="brand-text">
          <strong>LeaxPanel</strong>
          <small>Cloud Platform</small>
        </span>
      </a>
    </div>
    <div class="topbar-right">
      <a href="/setup" class="btn btn-ghost btn-sm hide-sm">Setup</a>
      <a href="/login" class="btn btn-secondary btn-sm">Sign in</a>
      <a href="/register" class="btn btn-primary btn-sm">Get started</a>
    </div>
  </header>

  <section class="hero">
    <div class="hero-bg"></div>
    <div class="hero-inner">
      <span class="hero-badge">LeaxPanel(os) v<%= typeof appVersion !== 'undefined' ? appVersion : '1.0.0' %> · Open source</span>
      <h1 class="hero-title">Host Anything.<br>Manage Everything.<br>Deploy Anywhere.</h1>
      <p class="hero-text">
        A complete cloud platform operating system in pure JavaScript. Deploy websites, NodeJS and PHP apps,
        automate with n8n, run bots, connect AI providers and manage every database — all from one dashboard.
        No SSH required.
      </p>
      <div class="hero-actions">
        <a href="/login" class="btn btn-primary btn-lg">Open the dashboard</a>
        <a href="https://github.com/netblood/LeaxPanel-OS-" target="_blank" rel="noopener" class="btn btn-secondary btn-lg">View on GitHub</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat">
          <div class="hero-stat-num">24+</div>
          <div class="hero-stat-lbl">Modules</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">0</div>
          <div class="hero-stat-lbl">External services</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">1</div>
          <div class="hero-stat-lbl">Command install</div>
        </div>
        <div class="hero-stat">
          <div class="hero-stat-num">∞</div>
          <div class="hero-stat-lbl">No SSH required</div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-head">
        <h2>Everything you need to run a cloud</h2>
        <p>One dashboard for infrastructure, applications, bots, AI and business operations.</p>
      </div>
      <div class="feature-grid">
        <div class="feature-card">
          <div class="feature-icon">🌐</div>
          <h3>Domains & Websites</h3>
          <p>DNS records, SSL certificates, website deployments and reverse proxy configuration.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📦</div>
          <h3>Application Hosting</h3>
          <p>NodeJS, PHP, WordPress and Docker apps with PM2, logs, env vars and scaling.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔄</div>
          <h3>N8N Automation</h3>
          <p>Deploy workflows, manage credentials, executions, variables and templates.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🎮</div>
          <h3>Bots Everywhere</h3>
          <p>Telegram, Discord and WhatsApp instances with QR pairing, webhooks and analytics.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🤖</div>
          <h3>AI Platform</h3>
          <p>Per-user providers, custom agents and knowledge bases across every major model.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🗄️</div>
          <h3>Database Center</h3>
          <p>SQLite, PostgreSQL, MongoDB and Redis managed from a single screen.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📁</div>
          <h3>File Manager</h3>
          <p>Upload, edit with syntax highlighting, rename, move, zip and extract.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🔒</div>
          <h3>Security Center</h3>
          <p>Security score, audit logs, IP lists, rate limits and 2FA for every account.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">💾</div>
          <h3>Backup Center</h3>
          <p>Scheduled snapshots of apps, databases, bots and workflows with rollback.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">📡</div>
          <h3>Custom API</h3>
          <p>API keys, webhooks, rate limits and usage analytics for your own integrations.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🎨</div>
          <h3>White Label</h3>
          <p>Your own name, logo, colours, domain and login page on every screen.</p>
        </div>
        <div class="feature-card">
          <div class="feature-icon">🩺</div>
          <h3>LeaxPanel Doctor</h3>
          <p>Health checks for routes, permissions, ports, SSL, backups and the database.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="section-inner">
      <div class="section-head">
        <h2>Built on a boring, reliable stack</h2>
        <p>No build step, no bundler, no framework lock-in. Just Node.js.</p>
      </div>
      <div class="tech-grid">
        <div class="tech-card"><h3 class="tech-name">Node.js 22+</h3><p class="tech-desc">Modern LTS runtime</p></div>
        <div class="tech-card"><h3 class="tech-name">Express</h3><p class="tech-desc">HTTP framework</p></div>
        <div class="tech-card"><h3 class="tech-name">EJS</h3><p class="tech-desc">Server-side templates</p></div>
        <div class="tech-card"><h3 class="tech-name">SQLite</h3><p class="tech-desc">better-sqlite3 storage</p></div>
        <div class="tech-card"><h3 class="tech-name">Socket.IO</h3><p class="tech-desc">Realtime events</p></div>
        <div class="tech-card"><h3 class="tech-name">PM2</h3><p class="tech-desc">Process management</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-inner">
      <div class="section-head">
        <h2>Install in one command</h2>
        <p>Dependencies, database, migrations, seeds and generated secrets — all handled automatically.</p>
      </div>
      <div class="install-tabs" data-tab-group>
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:var(--sp-4);">
          <button class="tab-btn active" data-tab-target="panel-win">Windows</button>
          <button class="tab-btn" data-tab-target="panel-linux">Linux / macOS</button>
          <button class="tab-btn" data-tab-target="panel-git">One command (GitHub)</button>
        </div>

        <div class="tab-pane active" id="panel-win">
          <pre class="code-block">git clone https://github.com/netblood/LeaxPanel-OS-.git
cd LeaxPanel-OS-
install.bat
run.bat</pre>
        </div>

        <div class="tab-pane" id="panel-linux">
          <pre class="code-block">git clone https://github.com/netblood/LeaxPanel-OS-.git
cd LeaxPanel-OS-
chmod +x install.sh run.sh
./install.sh
./run.sh</pre>
        </div>

        <div class="tab-pane" id="panel-git">
          <pre class="code-block">curl -fsSL https://raw.githubusercontent.com/netblood/LeaxPanel-OS-/main/install.sh | bash</pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="section-inner">
      <div class="cta-panel">
        <h2>Ready to deploy?</h2>
        <p>Sign in and take your first deployment in under five minutes.</p>
        <div class="cta-actions">
          <a href="/login" class="btn btn-primary btn-lg">Sign in to LeaxPanel</a>
          <a href="/setup" class="btn btn-secondary btn-lg">Run the setup wizard</a>
        </div>
      </div>
    </div>
  </section>

  <footer class="app-footer" style="border-top:1px solid var(--border);">
    <div class="app-footer-left">
      <span class="app-footer-brand">© <%= new Date().getFullYear() %> LeaxPanel</span>
      <span class="app-footer-sep">•</span>
      <span>Created &amp; organized by Bilal Chentouf (NetBlood)</span>
    </div>
    <div class="app-footer-right">
      <a href="https://github.com/netblood/LeaxPanel-OS-" target="_blank" rel="noopener" class="app-footer-link">GitHub</a>
      <a href="/health" class="app-footer-link">Status</a>
      <a href="/login" class="app-footer-link">Sign in</a>
    </div>
  </footer>

  <script src="/js/main.js"></script>
</body>
</html>
