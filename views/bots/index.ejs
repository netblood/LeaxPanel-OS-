<%- include('../partials/head'); %>
<title>Bots - LEAXOS</title>
<body>
  <%- include('../partials/navbar'); %>
  <main class="container">
    <%- include('../partials/flash'); %>
    <h1>Bots</h1>
    <table>
      <thead>
        <tr><th>ID</th><th>Name</th><th>Type</th><th>Status</th><th>Created</th></tr>
      </thead>
      <tbody>
        <% bots.forEach(function(bot) { %>
          <tr>
            <td><%= bot.id %></td>
            <td><%= bot.name %></td>
            <td><%= bot.type %></td>
            <td><%= bot.status %></td>
            <td><%= bot.created_at %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
  <script src="/js/main.js"></script>
</body>
