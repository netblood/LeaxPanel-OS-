<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title>Two-factor verification &middot; LeaxPanel</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '1.0.0' %>">
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <img src="/images/logo.png" alt="LeaxPanel" class="auth-logo-img">
      <span class="auth-brand-name"><strong>LeaxPanel</strong></span>
      <h1 class="auth-title">Two-factor verification</h1>
      <p class="auth-sub">Enter the 6-digit code from your authenticator app</p>
    </div>

    <%- include('../partials/flash'); %>

    <form action="/2fa/verify" method="POST" data-loading>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="token">Verification code</label>
        <input class="form-control text-center text-mono" type="text" id="token" name="token"
               placeholder="000000" required autofocus maxlength="6" inputmode="numeric"
               style="letter-spacing:8px;font-size:20px;height:52px;">
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">Verify</button>
    </form>

    <p class="auth-hint"><a href="/login">Back to sign in</a></p>
  </div>
</div>
</body>
</html>
