<% 
  const loginSettings = (typeof panelSettings !== 'undefined' && panelSettings) ? panelSettings : {};
  const brandName = loginSettings.panel_name || 'LeaxPanel';
  const brandTagline = loginSettings.panel_tagline || 'Host Anything. Manage Everything. Deploy Anywhere.';
  const primaryColor = loginSettings.primary_color || '#7c5cff';
  const accentColor = loginSettings.accent_color || '#22d3ee';
  const panelLogo = loginSettings.panel_logo || '/images/logo.png';
  const loginBgColor = loginSettings.login_bg_color || null;
  const loginBgImage = loginSettings.login_bg_image || null;
  const loginVideoBg = loginSettings.login_video_bg || null;
  const loginTitle = loginSettings.login_title || 'Welcome back';
  const loginSubtitle = loginSettings.login_subtitle || 'Sign in to your dashboard';
  const loginFooter = loginSettings.login_footer || 'Powered by LeaxPanel';
%>
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= brandName %> &middot; Sign in</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '1.0.0' %>">
  <style>
    :root {
      --primary: <%= primaryColor %>;
      --accent: <%= accentColor %>;
      --primary-soft: rgba(124, 92, 255, 0.10);
      --accent-soft: rgba(34, 211, 238, 0.10);
      <%- loginBgColor ? '--bg: ' + loginBgColor + ';' : '' %>
      <%- loginBgImage ? '--login-bg-image: url(' + loginBgImage + ');' : '' %>
    }
  </style>
</head>
<body>
  <div class="login-shell" style="<%- loginBgImage ? 'background-image: var(--login-bg-image); background-size: cover; background-position: center; background-attachment: fixed;' : '' %>">
    <div class="login-bg">
      <div class="login-glow login-glow-1"></div>
      <div class="login-glow login-glow-2"></div>
      <div class="login-glow login-glow-3"></div>
    </div>

    <div class="login-layout">
      <!-- Branding panel (desktop only) -->
      <div class="login-brand">
        <div class="login-brand-inner">
          <div class="login-brand-badge">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="2" x2="12" y2="22"></line>
              <line x1="2" y1="12" x2="22" y2="12"></line>
            </svg>
            <span>Secure access</span>
          </div>
          <a href="/" class="login-brand-link" aria-label="<%= brandName %>">
            <img src="<%= panelLogo %>" alt="<%= brandName %>" class="login-brand-logo">
            <span class="login-brand-name"><strong><%= brandName %></strong></span>
          </a>
          <p class="login-brand-tagline"><%= brandTagline %></p>
          <div class="login-brand-features">
            <div class="feature"><span class="feature-dot"></span><span>Instant deployment</span></div>
            <div class="feature"><span class="feature-dot"></span><span>Managed infrastructure</span></div>
            <div class="feature"><span class="feature-dot"></span><span>24/7 monitoring</span></div>
          </div>
        </div>
      </div>

      <!-- Login form panel -->
      <div class="login-form-panel">
        <div class="login-form-inner">
          <div class="login-header">
            <div class="login-logo">
              <img src="<%= panelLogo %>" alt="<%= brandName %>" class="login-logo-img">
            </div>
              <h1 class="login-title"><%= loginTitle %></h1>
              <p class="login-subtitle"><%= loginSubtitle %></p>
          </div>

          <%- include('../partials/flash'); %>

          <form action="/login" method="POST" class="login-form" data-loading>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="login-field-group">
              <label class="login-field-label" for="email">Email address</label>
              <div class="login-field-wrapper">
                <svg class="login-field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                <input class="login-field" type="email" id="email" name="email" placeholder="you@example.com" required autofocus autocomplete="email">
              </div>
            </div>

            <div class="login-field-group">
              <label class="login-field-label" for="password">Password</label>
              <div class="login-field-wrapper">
                <svg class="login-field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0110 0v4"></path>
                </svg>
                <input class="login-field" type="password" id="password" name="password" placeholder="••••••••" required autocomplete="current-password">
              </div>
            </div>

            <div class="login-actions">
              <button type="submit" class="login-btn btn-primary">Sign in</button>
            </div>
          </form>

          <% if (typeof registrationEnabled !== 'undefined' && registrationEnabled) { %>
            <p class="login-hint">No account yet? <a href="/register">Create one</a></p>
          <% } %>

          <div class="login-foot">
            <span class="login-foot-text"><%= loginFooter %></span>
            <a href="https://github.com/netblood/LeaxPanel-OS-" target="_blank" rel="noopener" class="login-foot-link">GitHub</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
