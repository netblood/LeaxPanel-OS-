<link rel="stylesheet" href="/css/style.css?v=<%= typeof appVersion !== 'undefined' ? appVersion : '1.0.0' %>">

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <span class="brand-mark">⚡</span>
      <h1 class="auth-title">Create your account</h1>
      <p class="auth-sub">Get started with LeaxPanel in under a minute</p>
    </div>

    <form action="/register" method="POST" data-loading>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label class="form-label" for="name">Full name</label>
        <input class="form-control" type="text" id="name" name="name" placeholder="Bilal Chentouf" required autofocus autocomplete="name">
      </div>

      <div class="form-group">
        <label class="form-label" for="email">Email address</label>
        <input class="form-control" type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email">
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <input class="form-control" type="password" id="password" name="password" placeholder="At least 8 characters" required minlength="8" autocomplete="new-password">
        <span class="form-hint">Use at least 8 characters. A strong mix of letters, numbers and symbols is recommended.</span>
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg">Create account</button>
    </form>

    <p class="auth-hint">Already registered? <a href="/login">Sign in</a></p>

    <div class="auth-foot">
      <a href="/">Back to home</a>
    </div>
  </div>
</div>
