<div class="page-header">
  <div>
    <h1 class="page-title">Create invoice</h1>
    <p class="page-subtitle">Issue a new invoice for a customer</p>
  </div>
  <div class="page-actions">
    <a href="/billing" class="btn btn-ghost">Back to billing</a>
  </div>
</div>

<form action="/billing/create" method="POST" class="card" data-loading>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="card-body">
    <div class="form-grid">
      <div class="form-group">
        <label class="form-label" for="customer_name">Customer name<span class="req">*</span></label>
        <input class="form-control" type="text" id="customer_name" name="customer_name" placeholder="Acme Corporation" required autofocus>
      </div>
      <div class="form-group">
        <label class="form-label" for="amount">Amount<span class="req">*</span></label>
        <input class="form-control" type="number" id="amount" name="amount" value="0" step="0.01" min="0" required>
      </div>
      <div class="form-group">
        <label class="form-label" for="currency">Currency</label>
        <input class="form-control" type="text" id="currency" name="currency" value="USD" maxlength="3">
      </div>
      <div class="form-group">
        <label class="form-label" for="status">Status</label>
        <select class="form-control" id="status" name="status">
          <% statuses.forEach(function(s) { %>
            <option value="<%= s %>"><%= s.charAt(0).toUpperCase() + s.slice(1) %></option>
          <% }); %>
        </select>
      </div>
    </div>
  </div>
  <div class="card-footer form-actions">
    <button type="submit" class="btn btn-primary">Create invoice</button>
    <a href="/billing" class="btn btn-ghost">Cancel</a>
  </div>
</form>
