<div class="page-header">
  <div>
    <h1 class="page-title"><%= pageTitle || 'Blueprints' %></h1>
    <p class="page-subtitle">Multi-service deployment bundles</p>
  </div>
  <div class="page-actions">
    <a href="/templates" class="btn btn-secondary">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
      Back to Marketplace
    </a>
  </div>
</div>

<div class="card">
  <div class="card-body">
    <% if (!blueprints || !blueprints.length) { %>
      <div class="empty-state">
        <div class="empty-icon">◇</div>
        <h3>No blueprints yet</h3>
        <p>Deployment blueprints bundle several services into a single install. None have been published yet.</p>
        <a href="/templates" class="btn btn-primary">Browse the marketplace</a>
      </div>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Blueprint</th>
              <th>Category</th>
              <th>Author</th>
              <th>Version</th>
              <th>Official</th>
              <th>Verified</th>
              <th>Created</th>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% blueprints.forEach(function(bp) { %>
              <tr>
                <td class="cell-primary"><%= bp.name || 'Blueprint' %></td>
                <td><%= bp.category || '—' %></td>
                <td><%= bp.author || '—' %></td>
                <td><%= bp.version || '—' %></td>
                <td><span class="badge <%= bp.is_official ? 'badge-success' : 'badge-muted' %>"><%= bp.is_official ? 'Yes' : 'No' %></span></td>
                <td><span class="badge <%= bp.is_verified ? 'badge-success' : 'badge-muted' %>"><%= bp.is_verified ? 'Yes' : 'No' %></span></td>
                <td><%= bp.created_at || '—' %></td>
                <td class="col-actions">
                  <a href="/templates/blueprints/<%= bp.id %>" class="btn btn-secondary btn-sm">View</a>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
