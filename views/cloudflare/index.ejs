<%- include('../partials/head'); %>
<title>Cloudflare - LEAXOS</title>
<body>
  <%- include('../partials/navbar'); %>
  <main class="container">
    <%- include('../partials/flash'); %>
    <h1>Cloudflare</h1>
    <table>
      <thead>
        <tr><th>ID</th><th>Zone</th><th>Status</th><th>Created</th></tr>
      </thead>
      <tbody>
        <% zones.forEach(function(zone) { %>
          <tr>
            <td><%= zone.id %></td>
            <td><%= zone.name %></td>
            <td><%= zone.status %></td>
            <td><%= zone.created_at %></td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </main>
  <script src="/js/main.js"></script>
</body>
