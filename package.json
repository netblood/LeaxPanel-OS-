{
  "name": "leaxpanel-os",
  "version": "1.0.0",
  "description": "LeaxPanel(os) - Complete Cloud Operating System",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "pm2": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop leaxpanel",
    "pm2:restart": "pm2 restart leaxpanel",
    "pm2:logs": "pm2 logs leaxpanel",
    "migrate": "node migrations/run.js",
    "seed": "node seeds/run.js",
    "install:setup": "node scripts/bootstrap.js",
    "verify": "node scripts/verify.js",
    "doctor": "node scripts/doctor-cli.js",
    "crawl": "node scripts/crawl-routes.js",
    "generate:views": "node scripts/generate-views.js && node scripts/generate-show-views.js",
    "setup": "node scripts/bootstrap.js && node scripts/verify.js"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "flash": "^1.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.1.7",
    "qr-image": "^3.2.0",
    "socket.io": "^4.7.2",
    "speakeasy": "^2.0.0",
    "ssh2": "^1.15.0",
    "uuid": "^14.0.3",
    "winston": "^3.11.0"
  }
}
